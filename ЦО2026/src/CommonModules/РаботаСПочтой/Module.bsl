// Прием IMAP и отправка SMTP через объект платформы ИнтернетПочта.
// Сценарий тот же, что у почтовой подсистемы БСП: учетная запись, получение, отправка, текст ошибки.
// В конфигурацию не встроена вся БСП: для кейса достаточно платформенного контура без сотен чужих объектов.

Процедура ПолучитьВходящиеРегламент() Экспорт
	
	Попытка
		Результат = ПолучитьВходящие();
		ЗаписьЖурналаРегистрации("ЦентрОбращений.Почта", УровеньЖурналаРегистрации.Информация, , ,
			"Получено писем: " + Формат(Результат.Создано, "ЧГ=0") + ". " + Результат.Текст);
	Исключение
		ЗаписьЖурналаРегистрации("ЦентрОбращений.Почта", УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьВходящие() Экспорт
	
	Итог = Новый Структура("Успех, Создано, Пропущено, Текст", Истина, 0, 0, "");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УчетныеЗаписи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УчетныеЗаписиПочты КАК УчетныеЗаписи
	|ГДЕ
	|	НЕ УчетныеЗаписи.ПометкаУдаления
	|	И УчетныеЗаписи.Используется";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Итог.Успех = Ложь;
		Итог.Текст = "Нет включенной учетной записи почты. Заполните справочник «Учетные записи почты»: сервер IMAP, порт, пользователь и пароль.";
		Возврат Итог;
	КонецЕсли;
	
	Сообщения = Новый Массив;
	Пока Истина Цикл
		Попытка
			Порция = ПрочитатьЯщик(Выборка.Ссылка);
		Исключение
			Итог.Успех = Ложь;
			Итог.Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Возврат Итог;
		КонецПопытки;
		Для Каждого Письмо Из Порция Цикл
			Сообщения.Добавить(Письмо);
		КонецЦикла;
		Если Не Выборка.Следующий() Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Письмо Из Сообщения Цикл
		Данные = Новый Структура;
		Данные.Вставить("Канал", Перечисления.КаналыОбращений.Почта);
		Данные.Вставить("Тема", Письмо.Тема);
		Данные.Вставить("Текст", Письмо.Текст);
		Данные.Вставить("АдресОтвета", Письмо.Адрес);
		Данные.Вставить("ВнешнийИдентификатор", Письмо.Идентификатор);
		Данные.Вставить("ИмяКонтрагента", Письмо.Имя);
		Данные.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
		Результат = ОбработкаОбращений.ПринятьВходящее(Данные);
		Если Результат.Повтор Тогда
			Итог.Пропущено = Итог.Пропущено + 1;
		ИначеЕсли Результат.Успех Тогда
			Итог.Создано = Итог.Создано + 1;
		КонецЕсли;
	КонецЦикла;
	Итог.Текст = "Новых обращений: " + Формат(Итог.Создано, "ЧГ=0")
		+ ", уже были в базе: " + Формат(Итог.Пропущено, "ЧГ=0") + ".";
	Возврат Итог;
	
КонецФункции

Функция ОтправитьПисьмо(УчетнаяЗапись, Кому, Тема, Текст) Экспорт
	
	Результат = Новый Структура("Успех, Текст", Ложь, "");
	Если Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		УчетнаяЗапись = ОсновнаяУчетнаяЗапись();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Результат.Текст = "Нет учетной записи для отправки. Заполните справочник «Учетные записи почты».";
		Возврат Результат;
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(Кому)) Тогда
		Результат.Текст = "Не заполнен адрес получателя.";
		Возврат Результат;
	КонецЕсли;
	
	Данные = УчетнаяЗапись.ПолучитьОбъект();
	Профиль = ПрофильПочты(Данные);
	Письмо = Новый ИнтернетПочтовоеСообщение;
	Письмо.Отправитель.Адрес = СокрЛП(Данные.АдресПочты);
	Письмо.ИмяОтправителя = "ТехноСервис";
	Письмо.Тема = Тема;
	ЧастьПисьма = Письмо.Тексты.Добавить(Текст);
	ЧастьПисьма.ТипТекста = ТипТекстаПочтовогоСообщения.ПростойТекст;
	Письмо.Получатели.Добавить(СокрЛП(Кому));
	
	Почта = Новый ИнтернетПочта;
	Попытка
		Почта.Подключиться(Профиль, ПротоколИнтернетПочты.SMTP);
		Почта.Послать(Письмо);
		Почта.Отключиться();
		Результат.Успех = Истина;
		Результат.Текст = "Письмо отправлено на " + СокрЛП(Кому) + ".";
	Исключение
		Результат.Текст = "Не удалось отправить письмо: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Попытка
			Почта.Отключиться();
		Исключение
		КонецПопытки;
	КонецПопытки;
	Возврат Результат;
	
КонецФункции

Функция ПрочитатьЯщик(УчетнаяЗапись)
	
	Данные = УчетнаяЗапись.ПолучитьОбъект();
	Если ПустаяСтрока(Данные.СерверIMAP) Или ПустаяСтрока(Данные.Пользователь) Тогда
		ВызватьИсключение "В учетной записи " + Данные.Наименование + " не заполнены сервер IMAP и пользователь.";
	КонецЕсли;
	
	Профиль = ПрофильПочты(Данные);
	Почта = Новый ИнтернетПочта;
	Письма = Новый Массив;
	Попытка
		Почта.Подключиться(Профиль, ПротоколИнтернетПочты.IMAP);
		Заголовки = Почта.ПолучитьЗаголовки();
		Если Заголовки.Количество() > 20 Тогда
			Последние = Новый Массив;
			Индекс = Заголовки.Количество() - 20;
			Пока Индекс < Заголовки.Количество() Цикл
				Последние.Добавить(Заголовки[Индекс]);
				Индекс = Индекс + 1;
			КонецЦикла;
			Заголовки = Последние;
		КонецЕсли;
		Если Заголовки.Количество() > 0 Тогда
			Сообщения = Почта.Выбрать(Ложь, Заголовки);
			Для Каждого Сообщение Из Сообщения Цикл
				Элемент = Новый Структура;
				Элемент.Вставить("Тема", Строка(Сообщение.Тема));
				Элемент.Вставить("Текст", ТекстПисьма(Сообщение));
				Элемент.Вставить("Адрес", АдресОтправителя(Сообщение));
				Элемент.Вставить("Имя", ИмяОтправителя(Сообщение));
				Элемент.Вставить("Идентификатор", ИдентификаторПисьма(Сообщение));
				Письма.Добавить(Элемент);
			КонецЦикла;
		КонецЕсли;
		Почта.Отключиться();
	Исключение
		Попытка
			Почта.Отключиться();
		Исключение
		КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	Возврат Письма;
	
КонецФункции

Функция ПрофильПочты(Данные)
	
	Профиль = Новый ИнтернетПочтовыйПрофиль;
	Профиль.АдресСервераIMAP = Данные.СерверIMAP;
	Профиль.ПортIMAP = ?(Данные.ПортIMAP <= 0, ?(Данные.ИспользоватьSSL, 993, 143), Данные.ПортIMAP);
	Профиль.ПользовательIMAP = Данные.Пользователь;
	Профиль.ПарольIMAP = Данные.Пароль;
	Профиль.ИспользоватьSSLIMAP = Данные.ИспользоватьSSL;
	Профиль.АдресСервераSMTP = ?(ПустаяСтрока(Данные.СерверSMTP), Данные.СерверIMAP, Данные.СерверSMTP);
	Профиль.ПортSMTP = ?(Данные.ПортSMTP <= 0, ?(Данные.ИспользоватьSSL, 465, 25), Данные.ПортSMTP);
	Профиль.ПользовательSMTP = Данные.Пользователь;
	Профиль.ПарольSMTP = Данные.Пароль;
	Профиль.ИспользоватьSSLSMTP = Данные.ИспользоватьSSL;
	Профиль.АутентификацияSMTP = СпособSMTPАутентификации.ПоУмолчанию;
	Профиль.Таймаут = 30;
	Возврат Профиль;
	
КонецФункции

Функция ОсновнаяУчетнаяЗапись()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УчетныеЗаписи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УчетныеЗаписиПочты КАК УчетныеЗаписи
	|ГДЕ
	|	НЕ УчетныеЗаписи.ПометкаУдаления
	|	И УчетныеЗаписи.Используется";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.УчетныеЗаписиПочты.ПустаяСсылка();
	
КонецФункции

Функция ТекстПисьма(Сообщение)
	
	Простой = "";
	Разметка = "";
	Для Каждого Часть Из Сообщение.Тексты Цикл
		Если Часть.ТипТекста = ТипТекстаПочтовогоСообщения.ПростойТекст И ПустаяСтрока(Простой) Тогда
			Простой = Часть.Текст;
		ИначеЕсли ПустаяСтрока(Разметка) Тогда
			Разметка = Часть.Текст;
		КонецЕсли;
	КонецЦикла;
	Если Не ПустаяСтрока(Простой) Тогда
		Возврат Простой;
	КонецЕсли;
	Возврат УбратьТеги(Разметка);
	
КонецФункции

Функция УбратьТеги(Текст)
	
	Результат = "";
	ВТеге = Ложь;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = "<" Тогда
			ВТеге = Истина;
		ИначеЕсли Символ = ">" Тогда
			ВТеге = Ложь;
		ИначеЕсли Не ВТеге Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат СокрЛП(Результат);
	
КонецФункции

Функция АдресОтправителя(Сообщение)
	
	Если Сообщение.Отправитель = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Сообщение.Отправитель.Адрес));
	
КонецФункции

Функция ИмяОтправителя(Сообщение)
	
	Если Сообщение.Отправитель = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Имя = СокрЛП(Строка(Сообщение.Отправитель.ОтображаемоеИмя));
	Если ПустаяСтрока(Имя) Тогда
		Имя = АдресОтправителя(Сообщение);
	КонецЕсли;
	Возврат Имя;
	
КонецФункции

Функция ИдентификаторПисьма(Сообщение)
	
	Идентификатор = СокрЛП(Строка(Сообщение.ИдентификаторСообщения));
	Если ПустаяСтрока(Идентификатор) Тогда
		Идентификатор = "imap:" + Строка(Сообщение.ДатаОтправления) + "|" + АдресОтправителя(Сообщение) + "|" + Строка(Сообщение.Тема);
	КонецЕсли;
	Возврат Идентификатор;
	
КонецФункции
