Функция СреднееВремяОтвета(Начало)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Обращение.ДатаПоступления КАК ДатаПоступления,
	|	Обращение.ДатаОтвета КАК ДатаОтвета
	|ИЗ
	|	Документ.ИОО_Обращение КАК Обращение
	|ГДЕ
	|	НЕ Обращение.ПометкаУдаления
	|	И Обращение.ДатаОтвета >= &Начало";
	Запрос.УстановитьПараметр("Начало", Начало);
	Выборка = Запрос.Выполнить().Выбрать();
	Сумма = 0;
	Количество = 0;
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.ДатаПоступления) Или Не ЗначениеЗаполнено(Выборка.ДатаОтвета) Тогда
			Продолжить;
		КонецЕсли;
		Сумма = Сумма + (Выборка.ДатаОтвета - Выборка.ДатаПоступления) / 60;
		Количество = Количество + 1;
	КонецЦикла;
	Если Количество = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Окр(Сумма / Количество, 0);
	
КонецФункции

Функция ТочностьМодели(Начало)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Обращение.СтатусВерификации КАК СтатусВерификации,
	|	КОЛИЧЕСТВО(Обращение.Ссылка) КАК Количество
	|ИЗ
	|	Документ.ИОО_Обращение КАК Обращение
	|ГДЕ
	|	НЕ Обращение.ПометкаУдаления
	|	И Обращение.ДатаКлассификации >= &Начало
	|	И (Обращение.СтатусВерификации = ЗНАЧЕНИЕ(Справочник.ИОО_СтатусыВерификации.Подтверждено)
	|		ИЛИ Обращение.СтатусВерификации = ЗНАЧЕНИЕ(Справочник.ИОО_СтатусыВерификации.Исправлено))
	|
	|СГРУППИРОВАТЬ ПО
	|	Обращение.СтатусВерификации";
	Запрос.УстановитьПараметр("Начало", Начало);
	Подтверждено = 0;
	Исправлено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.СтатусВерификации = Справочники.ИОО_СтатусыВерификации.Подтверждено Тогда
			Подтверждено = Выборка.Количество;
		Иначе
			Исправлено = Выборка.Количество;
		КонецЕсли;
	КонецЦикла;
	Всего = Подтверждено + Исправлено;
	Результат = Новый Структура("Текст, Доля", "нет проверенных обращений", 0);
	Если Всего > 0 Тогда
		Доля = Окр(100 * Подтверждено / Всего, 0);
		Результат.Доля = Доля;
		Результат.Текст = Формат(Доля, "ЧГ=0") + "% подтверждено без правок ("
			+ Формат(Подтверждено, "ЧГ=0") + " из " + Формат(Всего, "ЧГ=0") + ")";
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

