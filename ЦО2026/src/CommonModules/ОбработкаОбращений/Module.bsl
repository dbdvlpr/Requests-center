Функция ОграничитьЧисло(Значение, Минимум, Максимум)
	
	Числовое = 0;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Числовое = Значение;
	Иначе
		Попытка
			Числовое = Число(Значение);
		Исключение
			Числовое = Минимум;
		КонецПопытки;
	КонецЕсли;
	Возврат Макс(Минимум, Мин(Максимум, Цел(Числовое)));
	
КонецФункции

Функция ЗначениеСтруктуры(Данные, Имя)
	
	Если Данные.Свойство(Имя) И Данные[Имя] <> Неопределено Тогда
		Возврат СокрЛП(Строка(Данные[Имя]));
	КонецЕсли;
	Возврат "";
	
КонецФункции

Функция СтрокаПоля(Данные, Имя1, Имя2)
	
	Если Данные.Свойство(Имя1) И Данные[Имя1] <> Неопределено Тогда
		Возврат СокрЛП(Строка(Данные[Имя1]));
	КонецЕсли;
	Если Данные.Свойство(Имя2) И Данные[Имя2] <> Неопределено Тогда
		Возврат СокрЛП(Строка(Данные[Имя2]));
	КонецЕсли;
	Возврат "";
	
КонецФункции

Функция ЧислоПоля(Данные, Имя1, Имя2)
	
	Если Данные.Свойство(Имя1) И ТипЗнч(Данные[Имя1]) = Тип("Число") Тогда
		Возврат Данные[Имя1];
	КонецЕсли;
	Если Данные.Свойство(Имя2) И ТипЗнч(Данные[Имя2]) = Тип("Число") Тогда
		Возврат Данные[Имя2];
	КонецЕсли;
	Текст = СтрокаПоля(Данные, Имя1, Имя2);
	Если ПустаяСтрока(Текст) Тогда
		Возврат 1;
	КонецЕсли;
	Возврат ОграничитьЧисло(Текст, 1, 5);
	
КонецФункции
