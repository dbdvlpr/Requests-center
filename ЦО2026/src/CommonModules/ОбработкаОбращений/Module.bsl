Функция СформироватьПанель(Дней) Экспорт
	
	Если Дней <= 0 Тогда
		Дней = 1;
	КонецЕсли;
	Начало = НачалоДня(ТекущаяДатаСеанса()) - (Дней - 1) * 86400;
	Поступило = КоличествоПоступивших(Начало);
	Необработано = КоличествоНеобработанных();
	Среднее = СреднееВремяОтвета(Начало);
	Точность = ТочностьМодели(Начало);
	Категории = ДолиКатегорий(Начало);
	Очереди = ОчередиИсполнителей();
	Узкие = УзкиеМеста();
	
	Таб = Новый ТабличныйДокумент;
	Таб.Область(1, 1).Текст = "Панель руководителя, " + ?(Дней = 1, "сегодня", "7 дней");
	Таб.Область(1, 1).Шрифт = Новый Шрифт("Arial", 14, Истина);
	ВывестиСтроку(Таб, 3, "Поступило", Формат(Поступило, "ЧГ=0"));
	ВывестиСтроку(Таб, 4, "Не обработано сейчас", Формат(Необработано, "ЧГ=0"));
	ВывестиСтроку(Таб, 5, "Среднее время до ответа, мин", ?(Среднее = Неопределено, "нет ответов", Формат(Среднее, "ЧДЦ=0; ЧГ=0")));
	ВывестиСтроку(Таб, 6, "Точность модели", Точность.Текст);
	Таб.Область(8, 1).Текст = "Доля категорий";
	Таб.Область(8, 1).Шрифт = Новый Шрифт("Arial", 12, Истина);
	СтрокаТаб = 9;
	Для Каждого Категория Из Категории Цикл
		Доля = 0;
		Если Поступило > 0 Тогда
			Доля = Окр(100 * Категория.Количество / Поступило, 0);
		КонецЕсли;
		ВывестиСтроку(Таб, СтрокаТаб, Категория.Имя, Формат(Категория.Количество, "ЧГ=0") + " (" + Формат(Доля, "ЧГ=0") + "%)");
		СтрокаТаб = СтрокаТаб + 1;
	КонецЦикла;
	СтрокаТаб = СтрокаТаб + 1;
	Таб.Область(СтрокаТаб, 1).Текст = "Очередь инженеров";
	Таб.Область(СтрокаТаб, 1).Шрифт = Новый Шрифт("Arial", 12, Истина);
	СтрокаТаб = СтрокаТаб + 1;
	Для Каждого Очередь Из Очереди Цикл
		ВывестиСтроку(Таб, СтрокаТаб, Очередь.Имя, Формат(Очередь.Количество, "ЧГ=0"));
		СтрокаТаб = СтрокаТаб + 1;
	КонецЦикла;
	СтрокаТаб = СтрокаТаб + 1;
	Таб.Область(СтрокаТаб, 1).Текст = "Узкие места";
	Таб.Область(СтрокаТаб, 1).Шрифт = Новый Шрифт("Arial", 12, Истина);
	Для Каждого Пункт Из Узкие Цикл
		СтрокаТаб = СтрокаТаб + 1;
		Таб.Область(СтрокаТаб, 1).Текст = Пункт;
	КонецЦикла;
	
	Сводка = "Поступило: " + Формат(Поступило, "ЧГ=0")
		+ ". Не обработано: " + Формат(Необработано, "ЧГ=0")
		+ ". Точность: " + Точность.Текст + ".";
	Если Узкие.Количество() > 0 Тогда
		Сводка = Сводка + Символы.ПС + Узкие[0];
	КонецЕсли;
	Итог = Новый Структура;
	Итог.Вставить("Текст", Сводка);
	Итог.Вставить("Таб", Таб);
	Возврат Итог;
	
КонецФункции

Функция РассчитатьПриоритет(Срочность, УровеньЭмоциональности, ПриоритетКонтрагента) Экспорт
	
	СрочностьНорм = ОграничитьЧисло(Срочность, 1, 5);
	НадбавкаТона = 0;
	Если ЗначениеЗаполнено(УровеньЭмоциональности) Тогда
		НадбавкаТона = ОграничитьЧисло(УровеньЭмоциональности.Вес, 0, 2);
	КонецЕсли;
	НадбавкаУровня = 0;
	Если ЗначениеЗаполнено(ПриоритетКонтрагента)
		И ПриоритетКонтрагента.Ранг >= 3
		И СрочностьНорм >= 3 Тогда
		НадбавкаУровня = 1;
	КонецЕсли;
	Приоритет = Мин(5, СрочностьНорм + НадбавкаТона + НадбавкаУровня);
	Пояснение = "Срочность текста " + Формат(СрочностьНорм, "ЧГ=0")
		+ ". Эмоциональность добавляет " + Формат(НадбавкаТона, "ЧГ=0")
		+ ". Приоритет контрагента добавляет " + Формат(НадбавкаУровня, "ЧГ=0")
		+ " (высший ранг поднимает приоритет только при срочности текста от 3). Итог " + Формат(Приоритет, "ЧГ=0") + ".";
	Результат = Новый Структура;
	Результат.Вставить("Срочность", СрочностьНорм);
	Результат.Вставить("НадбавкаТона", НадбавкаТона);
	Результат.Вставить("НадбавкаУровня", НадбавкаУровня);
	Результат.Вставить("Приоритет", Приоритет);
	Результат.Вставить("Пояснение", Пояснение);
	Возврат Результат;
	
КонецФункции

Функция БаллНазначения(ВесОсновного, ВесСмежного, Открыто) Экспорт
	
	Если ВесОсновного <= 0 И ВесСмежного <= 0 Тогда
		Возврат -1000;
	КонецЕсли;
	Возврат 10 * ВесОсновного + 2 * ВесСмежного - 4 * Открыто;
	
КонецФункции

Функция ПланОтвета(Канал, Адрес, ТакжеНаПочту) Экспорт
	
	План = Новый Структура("Письмо, Публиковать, Звонок", Ложь, Ложь, Ложь);
	ЕстьАдрес = Не ПустаяСтрока(СокрЛП(Строка(Адрес)));
	Если Канал = Справочники.ИОО_КаналыОбращений.Почта Тогда
		План.Письмо = ЕстьАдрес;
	ИначеЕсли Канал = Справочники.ИОО_КаналыОбращений.ВебФорма Тогда
		План.Публиковать = Истина;
		План.Письмо = ЕстьАдрес;
	Иначе
		План.Звонок = Истина;
		План.Письмо = ТакжеНаПочту И ЕстьАдрес;
	КонецЕсли;
	Возврат План;
	
КонецФункции

Функция ОбезличитьТекст(Текст, Замены) Экспорт

	Результат = Строка(Текст);
	Если Замены <> Неопределено Тогда
		Для Каждого Замена Из Замены Цикл
			Значение = СокрЛП(Строка(Замена));
			Если СтрДлина(Значение) >= 3 Тогда
				Результат = СтрЗаменить(Результат, Значение, "<СКРЫТО>");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Обезличивание.ПроверитьУтечки(Результат).Текст;

КонецФункции

Функция АктивныйДоговор(Контрагент) Экспорт
	
	Результат = Новый Структура("Договор, Уровень, Пояснение",
		Справочники.Договоры.ПустаяСсылка(), Справочники.ИОО_ПриоритетыКонтрагентов.Обычный, "Действующего договора нет, уровень обычный.");
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Договоры.Ссылка КАК Ссылка,
	|	Договоры.ПриоритетКонтрагента КАК ПриоритетКонтрагента,
	|	Договоры.ДатаНачала КАК ДатаНачала,
	|	Договоры.ДатаОкончания КАК ДатаОкончания,
	|	Договоры.НомерДоговора КАК НомерДоговора
	|ИЗ
	|	Справочник.Договоры КАК Договоры
	|ГДЕ
	|	Договоры.Контрагент = &Контрагент
	|	И Договоры.Действует
	|	И НЕ Договоры.ПометкаУдаления";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	ЛучшийРанг = 0;
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ДатаНачала) И Выборка.ДатаНачала > Сегодня Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ДатаОкончания) И Выборка.ДатаОкончания < Сегодня Тогда
			Продолжить;
		КонецЕсли;
		Ранг = РангУровня(Выборка.ПриоритетКонтрагента);
		Если Ранг > ЛучшийРанг Тогда
			ЛучшийРанг = Ранг;
			Результат.Договор = Выборка.Ссылка;
			Результат.Уровень = Выборка.ПриоритетКонтрагента;
			Результат.Пояснение = "Уровень взят из договора " + Выборка.НомерДоговора + ": " + Строка(Выборка.ПриоритетКонтрагента) + ".";
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция Самопроверка() Экспорт
	
	Ошибки = Новый Массив;
	ПроверитьПриоритеты(Ошибки);
	ПроверитьБаллы(Ошибки);
	ПроверитьПланы(Ошибки);
	ПроверитьОбезличивание(Ошибки);
	ПроверитьРазборJSON(Ошибки);
	ПроверитьНазначениеВБазе(Ошибки);
	Панель = СформироватьПанель(7);
	Если ПустаяСтрока(Панель.Текст) Тогда
		Ошибки.Добавить("Панель руководителя не построилась.");
	КонецЕсли;
	Если Ошибки.Количество() = 0 Тогда
		Возврат "OK";
	КонецЕсли;
	Возврат СтрСоединить(Ошибки, Символы.ПС);
	
КонецФункции

Функция ХешТекста(Текст) Экспорт
	
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(Текст);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
	
КонецФункции

Процедура ПроверитьПриоритеты(Ошибки)
	
	ОжидатьПриоритет(Ошибки, 5, Справочники.ИОО_УровниЭмоциональности.Раздраженный, Справочники.ИОО_ПриоритетыКонтрагентов.VIP, 5);
	ОжидатьПриоритет(Ошибки, 5, Справочники.ИОО_УровниЭмоциональности.Нейтральный, Справочники.ИОО_ПриоритетыКонтрагентов.Обычный, 5);
	ОжидатьПриоритет(Ошибки, 2, Справочники.ИОО_УровниЭмоциональности.Нейтральный, Справочники.ИОО_ПриоритетыКонтрагентов.VIP, 2);
	ОжидатьПриоритет(Ошибки, 3, Справочники.ИОО_УровниЭмоциональности.Недовольный, Справочники.ИОО_ПриоритетыКонтрагентов.VIP, 5);
	ОжидатьПриоритет(Ошибки, 3, Справочники.ИОО_УровниЭмоциональности.Недовольный, Справочники.ИОО_ПриоритетыКонтрагентов.Обычный, 4);
	ОжидатьПриоритет(Ошибки, 3, Справочники.ИОО_УровниЭмоциональности.Нейтральный, Справочники.ИОО_ПриоритетыКонтрагентов.Приоритетный, 3);
	ОжидатьПриоритет(Ошибки, 4, Справочники.ИОО_УровниЭмоциональности.Нейтральный, Справочники.ИОО_ПриоритетыКонтрагентов.VIP, 5);
	ОжидатьПриоритет(Ошибки, 1, Справочники.ИОО_УровниЭмоциональности.Раздраженный, Справочники.ИОО_ПриоритетыКонтрагентов.VIP, 2);
	
КонецПроцедуры

Процедура ОжидатьПриоритет(Ошибки, Срочность, Тон, Уровень, Ожидание)
	
	Факт = РассчитатьПриоритет(Срочность, Тон, Уровень).Приоритет;
	Если Факт <> Ожидание Тогда
		Ошибки.Добавить("Приоритет " + Формат(Срочность, "ЧГ=0") + "/" + Строка(Тон) + "/" + Строка(Уровень)
			+ " = " + Формат(Факт, "ЧГ=0") + ", ожидалось " + Формат(Ожидание, "ЧГ=0"));
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьБаллы(Ошибки)
	
	Если БаллНазначения(3, 0, 4) <> 14 Тогда
		Ошибки.Добавить("Балл перегруженного эксперта рассчитан неверно.");
	КонецЕсли;
	Если БаллНазначения(2, 0, 0) <> 20 Тогда
		Ошибки.Добавить("Балл свободного инженера рассчитан неверно.");
	КонецЕсли;
	Если БаллНазначения(0, 3, 0) <> 6 Тогда
		Ошибки.Добавить("Балл смежной компетенции рассчитан неверно.");
	КонецЕсли;
	Если БаллНазначения(0, 0, 5) <> -1000 Тогда
		Ошибки.Добавить("Сотрудник без компетенции не должен попадать в кандидаты.");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьПланы(Ошибки)
	
	Почта = ПланОтвета(Справочники.ИОО_КаналыОбращений.Почта, "a@b.c", Ложь);
	Если Не Почта.Письмо Или Почта.Публиковать Тогда
		Ошибки.Добавить("Ответ на почту должен уходить письмом.");
	КонецЕсли;
	Форма = ПланОтвета(Справочники.ИОО_КаналыОбращений.ВебФорма, "a@b.c", Ложь);
	Если Не Форма.Публиковать Или Не Форма.Письмо Тогда
		Ошибки.Добавить("Ответ веб-формы публикуется и дублируется на почту, если адрес есть.");
	КонецЕсли;
	ФормаБезПочты = ПланОтвета(Справочники.ИОО_КаналыОбращений.ВебФорма, "", Ложь);
	Если Не ФормаБезПочты.Публиковать Или ФормаБезПочты.Письмо Тогда
		Ошибки.Добавить("Веб-форма без адреса публикует ответ и не пытается слать письмо.");
	КонецЕсли;
	Звонок = ПланОтвета(Справочники.ИОО_КаналыОбращений.Звонок, "a@b.c", Ложь);
	Если Не Звонок.Звонок Или Звонок.Письмо Тогда
		Ошибки.Добавить("По звонку ответ фиксируется как сообщенный клиенту.");
	КонецЕсли;
	ЗвонокСПочтой = ПланОтвета(Справочники.ИОО_КаналыОбращений.Звонок, "a@b.c", Истина);
	Если Не ЗвонокСПочтой.Звонок Или Не ЗвонокСПочтой.Письмо Тогда
		Ошибки.Добавить("По звонку письмо уходит только по отдельной отметке оператора.");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьОбезличивание(Ошибки)

	Токенизация = Перечисления.ИОО_РежимыОбезличивания.Токенизация;
	Маскировка = Перечисления.ИОО_РежимыОбезличивания.Маскировка;
	Выключено = Перечисления.ИОО_РежимыОбезличивания.Выключено;

	// Контроль утечек работает независимо от справочника правил.
	ПроверитьНетПДн(Ошибки, "почта", "Пишите на ivan.petrov@example.com, ответим.");
	ПроверитьНетПДн(Ошибки, "телефон с точками", "Звоните 8.495.111.22.33 после 10:00.");
	ПроверитьНетПДн(Ошибки, "телефон в скобках", "Мой номер +7 (916) 555-44-33.");
	ПроверитьНетПДн(Ошибки, "ИНН из 10 цифр", "ИНН организации 7701234567, прошу счет.");
	ПроверитьНетПДн(Ошибки, "ИНН из 12 цифр", "ИНН 770123456789, нужен договор.");

	Организация = Новый Массив;
	Пара = Новый Структура("Значение, ТипДанных");
	Пара.Значение = "ООО Ромашка";
	Пара.ТипДанных = Перечисления.ИОО_ТипыДанныхПДн.Организация;
	Организация.Добавить(Пара);
	Исходный = "Договор с ООО Ромашка на поставку.";

	Токенизированный = Обезличивание.Обезличить(Исходный, Неопределено, Токенизация, Организация);
	Если СтрНайти(ВРег(Токенизированный.Текст), "РОМАШКА") > 0 Тогда
		Ошибки.Добавить("Токенизация не скрыла организацию: " + Токенизированный.Текст);
	КонецЕсли;
	Если СтрНайти(Токенизированный.Текст, "<КЛИЕНТ_1>") = 0 Тогда
		Ошибки.Добавить("Токенизация не выдала токен организации: " + Токенизированный.Текст);
	КонецЕсли;

	Маскированный = Обезличивание.Обезличить(Исходный, Неопределено, Маскировка, Организация);
	Если СтрНайти(Маскированный.Текст, "<СКРЫТО>") = 0 Или СтрНайти(ВРег(Маскированный.Текст), "РОМАШКА") > 0 Тогда
		Ошибки.Добавить("Маскировка не заменила организацию: " + Маскированный.Текст);
	КонецЕсли;

	БезОбезличивания = Обезличивание.Обезличить(Исходный, Неопределено, Выключено, Организация);
	Если БезОбезличивания.Текст <> Исходный Тогда
		Ошибки.Добавить("Режим «Выключено» изменил текст обращения.");
	КонецЕсли;

	Артикул = Обезличивание.ПроверитьУтечки("Артикул A-12345, сумма 12 000 руб.");
	Если СтрНайти(Артикул.Текст, "<СКРЫТО>") > 0 Тогда
		Ошибки.Добавить("Контроль утечек замаскировал артикул или сумму: " + Артикул.Текст);
	КонецЕсли;

	Повторно = Обезличивание.ПроверитьУтечки(Токенизированный.Текст);
	Если Повторно.Текст <> Токенизированный.Текст Тогда
		Ошибки.Добавить("Повторное обезличивание изменило уже обезличенный текст.");
	КонецЕсли;

	Пустой = Обезличивание.Обезличить("", Неопределено, Токенизация);
	Если Пустой.Замен <> 0 Или Пустой.Утечек <> 0 Тогда
		Ошибки.Добавить("Пустой текст дал замены или утечки.");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьНетПДн(Ошибки, ИмяКейса, Текст)

	Проверка = Обезличивание.ПроверитьУтечки(Текст);
	Если СтрНайти(Проверка.Текст, "<СКРЫТО>") = 0 Тогда
		Ошибки.Добавить("Контроль утечек не нашёл ПДн (" + ИмяКейса + "): " + Текст);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьРазборJSON(Ошибки)
	
	Данные = ИнтеграцияLLM.ИзвлечьОбъектJSON("```json" + Символы.ПС + "{""category"":""Жалоба"",""urgency"":4}" + Символы.ПС + "```");
	Если ТипЗнч(Данные) <> Тип("Структура") Или СтрокаПоля(Данные, "category", "категория") <> "Жалоба" Тогда
		Ошибки.Добавить("Не разобран JSON модели в ограждении markdown.");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьНазначениеВБазе(Ошибки)
	
	НачатьТранзакцию();
	Попытка
		Тег = Справочники.ИОО_ТегиКомпетенций.СоздатьЭлемент();
		Тег.Наименование = "SELFCHECK ремонт";
		Тег.Записать();
		Сильный = СоздатьИнженераПроверки("SELFCHECK сильный", Тег.Ссылка, 3);
		Следующий = СоздатьИнженераПроверки("SELFCHECK следующий", Тег.Ссылка, 2);
		Категория = Справочники.ИОО_КатегорииОбращений.СоздатьЭлемент();
		Категория.Наименование = "SELFCHECK неисправность";
		Категория.ОсновнойТег = Тег.Ссылка;
		Категория.Записать();
		Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
		Контрагент.Наименование = "SELFCHECK клиент";
		Контрагент.Записать();
		Обычный = СоздатьДоговорПроверки(Контрагент.Ссылка, "SELF-1", Справочники.ИОО_ПриоритетыКонтрагентов.Обычный, Истина);
		VIP = СоздатьДоговорПроверки(Контрагент.Ссылка, "SELF-VIP", Справочники.ИОО_ПриоритетыКонтрагентов.VIP, Истина);
		Уровень = АктивныйДоговор(Контрагент.Ссылка);
		Если Уровень.Договор <> VIP Тогда
			Ошибки.Добавить("Из двух действующих договоров выбран не VIP.");
		КонецЕсли;
		Для Номер = 1 По 4 Цикл
			Документ = Документы.ИОО_Обращение.СоздатьДокумент();
			Документ.Дата = ТекущаяДатаСеанса();
			Документ.ДатаПоступления = Документ.Дата;
			Документ.Канал = Справочники.ИОО_КаналыОбращений.Почта;
			Документ.Текст = "Нагрузка " + Формат(Номер, "ЧГ=0");
			Документ.Категория = Категория.Ссылка;
			Документ.Исполнитель = Сильный;
			Документ.Статус = Справочники.ИОО_СтатусыОбращений.Назначено;
			Документ.Записать();
		КонецЦикла;
		Новое = Документы.ИОО_Обращение.СоздатьДокумент();
		Новое.Дата = ТекущаяДатаСеанса();
		Новое.ДатаПоступления = Новое.Дата;
		Новое.Канал = Справочники.ИОО_КаналыОбращений.Почта;
		Новое.Текст = "Новая неисправность";
		Новое.Категория = Категория.Ссылка;
		Новое.Статус = Справочники.ИОО_СтатусыОбращений.Новое;
		Новое.Записать();
		Назначение = ПодобратьИсполнителя(Категория.Ссылка, Новое.Ссылка);
		Если Назначение.Исполнитель <> Следующий Тогда
			Ошибки.Добавить("При загрузке эксперта заявка должна уйти следующему по компетенции. Выбран: " + Строка(Назначение.Исполнитель));
		КонецЕсли;
		Если Обычный = VIP Тогда
			Ошибки.Добавить("Проверочные договоры совпали.");
		КонецЕсли;
		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибки.Добавить(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция СоздатьИнженераПроверки(Имя, Тег, Вес)
	
	Инженер = Справочники.Сотрудники.СоздатьЭлемент();
	Инженер.Наименование = Имя;
	Инженер.ЭтоИнженер = Истина;
	Инженер.Доступен = Истина;
	Строка = Инженер.ИОО_Компетенции.Добавить();
	Строка.Тег = Тег;
	Строка.Вес = Вес;
	Инженер.Записать();
	Возврат Инженер.Ссылка;
	
КонецФункции

Функция СоздатьДоговорПроверки(Контрагент, Номер, Уровень, Действует)
	
	Договор = Справочники.Договоры.СоздатьЭлемент();
	Договор.Наименование = Номер;
	Договор.Контрагент = Контрагент;
	Договор.НомерДоговора = Номер;
	Договор.ДатаНачала = НачалоДня(ТекущаяДатаСеанса()) - 30 * 86400;
	Договор.ПриоритетКонтрагента = Уровень;
	Договор.Действует = Действует;
	Договор.Записать();
	Возврат Договор.Ссылка;
	
КонецФункции

Функция ПодобратьИсполнителя(Категория, ТекущееОбращение)
	
	Результат = Новый Структура("Исполнитель, Оценка, Пояснение",
		Справочники.Сотрудники.ПустаяСсылка(), 0, "Подходящий свободный инженер не найден.");
	Если Не ЗначениеЗаполнено(Категория) Тогда
		Возврат Результат;
	КонецЕсли;
	Карточка = Категория.ПолучитьОбъект();
	Основной = Карточка.ОсновнойТег;
	Смежные = Новый Соответствие;
	Для Каждого Строка Из Карточка.СмежныеТеги Цикл
		Если ЗначениеЗаполнено(Строка.Тег) Тогда
			Смежные.Вставить(Строка.Тег, Истина);
		КонецЕсли;
	КонецЦикла;
	Загрузка = ОткрытыеПоИсполнителям(ТекущееОбращение);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Ссылка,
	|	Сотрудники.Наименование КАК Наименование,
	|	Сотрудники.Доступен КАК Доступен
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	НЕ Сотрудники.ПометкаУдаления
	|	И Сотрудники.ЭтоИнженер";
	Выборка = Запрос.Выполнить().Выбрать();
	ЛучшийБалл = -999;
	Пока Выборка.Следующий() Цикл
		Если Не Выборка.Доступен Тогда
			Продолжить;
		КонецЕсли;
		Веса = ВесаСотрудника(Выборка.Ссылка, Основной, Смежные);
		Открыто = 0;
		Если Загрузка.Получить(Выборка.Ссылка) <> Неопределено Тогда
			Открыто = Загрузка.Получить(Выборка.Ссылка);
		КонецЕсли;
		Балл = БаллНазначения(Веса.Основной, Веса.Смежный, Открыто);
		Если Балл = -1000 Тогда
			Продолжить;
		КонецЕсли;
		Если Балл > ЛучшийБалл Или (Балл = ЛучшийБалл И Строка(Выборка.Наименование) < Строка(Результат.Исполнитель)) Тогда
			ЛучшийБалл = Балл;
			Результат.Исполнитель = Выборка.Ссылка;
			Результат.Оценка = Балл;
			Результат.Пояснение = Выборка.Наименование + ": балл " + Формат(Балл, "ЧГ=0")
				+ " (компетенция " + Формат(Веса.Основной, "ЧГ=0")
				+ ", смежная " + Формат(Веса.Смежный, "ЧГ=0")
				+ ", открытых " + Формат(Открыто, "ЧГ=0") + ").";
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Результат.Исполнитель) Тогда
		Результат.Пояснение = "Ни у одного доступного инженера нет компетенции категории «" + Категория.Наименование + "».";
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

Функция ВесаСотрудника(Сотрудник, Основной, Смежные)
	
	Веса = Новый Структура("Основной, Смежный", 0, 0);
	Объект = Сотрудник.ПолучитьОбъект();
	Для Каждого Строка Из Объект.ИОО_Компетенции Цикл
		Если Не ЗначениеЗаполнено(Строка.Тег) Тогда
			Продолжить;
		КонецЕсли;
		Вес = ?(Строка.Вес <= 0, 1, Строка.Вес);
		Если Строка.Тег = Основной И Вес > Веса.Основной Тогда
			Веса.Основной = Вес;
		ИначеЕсли Смежные.Получить(Строка.Тег) <> Неопределено И Вес > Веса.Смежный Тогда
			Веса.Смежный = Вес;
		КонецЕсли;
	КонецЦикла;
	Возврат Веса;
	
КонецФункции

Функция ОткрытыеПоИсполнителям(КромеСсылки)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Обращение.Исполнитель КАК Исполнитель,
	|	КОЛИЧЕСТВО(Обращение.Ссылка) КАК Количество
	|ИЗ
	|	Документ.ИОО_Обращение КАК Обращение
	|ГДЕ
	|	НЕ Обращение.ПометкаУдаления
	|	И Обращение.Ссылка <> &Кроме
	|	И Обращение.Исполнитель <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|	И Обращение.Статус <> ЗНАЧЕНИЕ(Справочник.ИОО_СтатусыОбращений.ОтветОтправлен)
	|	И Обращение.Статус <> ЗНАЧЕНИЕ(Справочник.ИОО_СтатусыОбращений.Закрыто)
	|
	|СГРУППИРОВАТЬ ПО
	|	Обращение.Исполнитель";
	Запрос.УстановитьПараметр("Кроме", ?(ЗначениеЗаполнено(КромеСсылки), КромеСсылки, Документы.ИОО_Обращение.ПустаяСсылка()));
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Исполнитель, Выборка.Количество);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция СписокКатегорий()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Категории.Ссылка КАК Ссылка,
	|	Категории.Код КАК Код,
	|	Категории.Наименование КАК Наименование,
	|	Категории.Подсказка КАК Подсказка
	|ИЗ
	|	Справочник.ИОО_КатегорииОбращений КАК Категории
	|ГДЕ
	|	НЕ Категории.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Категории.Наименование";
	Список = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура("Ссылка, Код, Наименование, Подсказка");
		Элемент.Ссылка = Выборка.Ссылка;
		Элемент.Код = Выборка.Код;
		Элемент.Наименование = Выборка.Наименование;
		Элемент.Подсказка = Выборка.Подсказка;
		Список.Добавить(Элемент);
	КонецЦикла;
	Возврат Список;
	
КонецФункции

Функция СистемныйПромпт(Категории)
	
	Описание = "";
	Для Каждого Категория Из Категории Цикл
		Описание = Описание + "- " + Категория.Наименование;
		Если Не ПустаяСтрока(Категория.Подсказка) Тогда
			Описание = Описание + ": " + Категория.Подсказка;
		КонецЕсли;
		Описание = Описание + Символы.ПС;
	КонецЦикла;
	Примеры = ПримерыДляПромпта();
	Возврат "Ты диспетчер сервисной компании ТехноСервис. Классифицируй обращение клиента. "
		+ "Верни только JSON без markdown: {""category"":"""",""urgency"":1,""sentiment"":""нейтральный"",""keywords"":[],""explanation"":""""}. "
		+ "category — строго одно название из списка. Если предмет неясен, выбери «Прочее». "
		+ "urgency — целое 1..5 только по тексту: 5 если оборудование остановлено, линия встала или простой; "
		+ "4 если явная неисправность без остановки; 2 если плановый вопрос. Не учитывай статус клиента. "
		+ "sentiment: нейтральный, недовольный или раздраженный. "
		+ "keywords — слова для поиска запчасти, можно пустой массив." + Символы.ПС
		+ "Категории:" + Символы.ПС + Описание + Примеры;
	
КонецФункции

Функция ПользовательскийПромпт(Документ, Текст)
	
	Возврат "Канал: " + Строка(Документ.Канал) + Символы.ПС
		+ "Текст:" + Символы.ПС + Текст;
	
КонецФункции

Функция ПримерыДляПромпта()

	Если Не ИнтеграцияLLM.ФункцияДоступна(ИнтеграцияLLM.АктивныйПрофиль(), Перечисления.ИОО_ФункцииПрофиля.FewShot) Тогда
		Возврат "";
	КонецЕсли;
	Количество = ИнтеграцияLLM.ПараметрыПодключения().КоличествоПримеров;
	Если Количество <= 0 Тогда
		Количество = 4;
	КонецЕсли;
	Если Количество > 8 Тогда
		Количество = 8;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 8
	|	Исправления.ТекстОбращения КАК ТекстОбращения,
	|	Исправления.ИсправленныйОтвет КАК ИсправленныйОтвет,
	|	Исправления.Дата КАК Дата
	|ИЗ
	|	РегистрСведений.ИсправленияКлассификации КАК Исправления
	|ГДЕ
	|	Исправления.ИспользоватьВПромпте
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Текст = "";
	Номер = 0;
	Пока Выборка.Следующий() Цикл
		Номер = Номер + 1;
		Если Номер > Количество Тогда
			Прервать;
		КонецЕсли;
		Текст = Текст + "Пример " + Формат(Номер, "ЧГ=0") + ": " + Лев(Выборка.ТекстОбращения, 400)
			+ " => " + Выборка.ИсправленныйОтвет + Символы.ПС;
	КонецЦикла;
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Возврат "Исправления операторов, им нужно следовать:" + Символы.ПС + Текст;
	
КонецФункции

Функция НайтиКатегорию(Категории, Имя)
	
	Норма = НормализоватьКлюч(Имя);
	Если ПустаяСтрока(Норма) Тогда
		Возврат Справочники.ИОО_КатегорииОбращений.ПустаяСсылка();
	КонецЕсли;
	Для Каждого Категория Из Категории Цикл
		Если НормализоватьКлюч(Категория.Наименование) = Норма
			Или НормализоватьКлюч(Категория.Код) = Норма Тогда
			Возврат Категория.Ссылка;
		КонецЕсли;
	КонецЦикла;
	Возврат Справочники.ИОО_КатегорииОбращений.ПустаяСсылка();

КонецФункции

// Приводит название категории к сравнимому виду: регистр, кавычки, точки, лишние пробелы.
Функция НормализоватьКлюч(Значение)

	Результат = НРег(СокрЛП(Строка(Значение)));
	Результат = СтрЗаменить(Результат, """", "");
	Результат = СтрЗаменить(Результат, "«", "");
	Результат = СтрЗаменить(Результат, "»", "");
	Результат = СтрЗаменить(Результат, ".", "");
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ТональностьПоТексту(Значение)
	
	Норма = НРег(СокрЛП(Значение));
	Если СтрНайти(Норма, "раздраж") > 0 Тогда
		Возврат Справочники.ИОО_УровниЭмоциональности.Раздраженный;
	ИначеЕсли СтрНайти(Норма, "недоволь") > 0 Тогда
		Возврат Справочники.ИОО_УровниЭмоциональности.Недовольный;
	КонецЕсли;
	Возврат Справочники.ИОО_УровниЭмоциональности.Нейтральный;
	
КонецФункции

Функция ПодобратьНоменклатуру(Текст, Дополнительно)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Наименование КАК Наименование,
	|	Номенклатура.Артикул КАК Артикул,
	|	Номенклатура.Описание КАК Описание,
	|	Номенклатура.Остаток КАК Остаток,
	|	Номенклатура.Цена КАК Цена,
	|	Номенклатура.КлючевыеСлова КАК КлючевыеСлова
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Область = НРег(Текст + " " + Дополнительно);
	Оцененные = Новый ТаблицаЗначений;
	Оцененные.Колонки.Добавить("Балл");
	Оцененные.Колонки.Добавить("Наименование");
	Оцененные.Колонки.Добавить("Артикул");
	Оцененные.Колонки.Добавить("Описание");
	Оцененные.Колонки.Добавить("Остаток");
	Оцененные.Колонки.Добавить("Цена");
	Пока Выборка.Следующий() Цикл
		Балл = 0;
		Если Не ПустаяСтрока(Выборка.Артикул) И СтрНайти(Область, НРег(Выборка.Артикул)) > 0 Тогда
			Балл = Балл + 10;
		КонецЕсли;
		Для Каждого Слово Из СтрРазделить(НРег(Выборка.Наименование + " " + Выборка.КлючевыеСлова), " ", Ложь) Цикл
			Если СтрДлина(Слово) >= 4 И СтрНайти(Область, Слово) > 0 Тогда
				Балл = Балл + 2;
			КонецЕсли;
		КонецЦикла;
		Если Балл > 0 Тогда
			Строка = Оцененные.Добавить();
			Строка.Балл = Балл;
			Строка.Наименование = Выборка.Наименование;
			Строка.Артикул = Выборка.Артикул;
			Строка.Описание = Выборка.Описание;
			Строка.Остаток = Выборка.Остаток;
			Строка.Цена = Выборка.Цена;
		КонецЕсли;
	КонецЦикла;
	Оцененные.Сортировать("Балл Убыв");
	Результат = Новый Массив;
	Индекс = 0;
	Пока Индекс < Оцененные.Количество() И Индекс < 8 Цикл
		Результат.Добавить(Оцененные[Индекс]);
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция СтрокиСписка(ТолькоСрочные)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 80
	|	Обращение.Ссылка КАК Ссылка,
	|	Обращение.Номер КАК Номер,
	|	Обращение.ДатаПоступления КАК ДатаПоступления,
	|	Обращение.Канал КАК Канал,
	|	Обращение.Контрагент.Наименование КАК Контрагент,
	|	Обращение.Категория.Наименование КАК Категория,
	|	Обращение.Приоритет КАК Приоритет,
	|	Обращение.УровеньЭмоциональности КАК Тональность,
	|	Обращение.УровеньКонтрагента КАК ПриоритетКонтрагента,
	|	Обращение.Исполнитель.Наименование КАК Исполнитель,
	|	Обращение.Тема КАК Тема,
	|	Обращение.Статус КАК Статус
	|ИЗ
	|	Документ.ИОО_Обращение КАК Обращение
	|ГДЕ
	|	НЕ Обращение.ПометкаУдаления
	|	И Обращение.Статус <> ЗНАЧЕНИЕ(Справочник.ИОО_СтатусыОбращений.ОтветОтправлен)
	|	И Обращение.Статус <> ЗНАЧЕНИЕ(Справочник.ИОО_СтатусыОбращений.Закрыто)
	|	И (&Все ИЛИ Обращение.Приоритет >= 4)";
	Запрос.УстановитьПараметр("Все", Не ТолькоСрочные);
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номер");
	Таблица.Колонки.Добавить("Канал");
	Таблица.Колонки.Добавить("Контрагент");
	Таблица.Колонки.Добавить("Категория");
	Таблица.Колонки.Добавить("Приоритет");
	Таблица.Колонки.Добавить("Тональность");
	Таблица.Колонки.Добавить("Исполнитель");
	Таблица.Колонки.Добавить("Статус");
	Таблица.Колонки.Добавить("Уровень");
	Таблица.Колонки.Добавить("Тема");
	Таблица.Колонки.Добавить("Ожидание");
	Таблица.Колонки.Добавить("Ссылка");
	Таблица.Колонки.Добавить("Ранг");
	Таблица.Колонки.Добавить("ДатаПоступления");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Таблица.Добавить();
		Строка.Номер = Выборка.Номер;
		Строка.Канал = Строка(Выборка.Канал);
		Строка.Контрагент = Строка(Выборка.Контрагент);
		Строка.Категория = Строка(Выборка.Категория);
		Строка.Приоритет = Выборка.Приоритет;
		Строка.Тональность = Строка(Выборка.Тональность);
		Строка.Исполнитель = Строка(Выборка.Исполнитель);
		Строка.Статус = Строка(Выборка.Статус);
		Строка.Уровень = Строка(Выборка.ПриоритетКонтрагента);
		Строка.Тема = Выборка.Тема;
		Строка.Ссылка = Выборка.Ссылка;
		Строка.Ранг = РангУровня(Выборка.ПриоритетКонтрагента);
		Строка.ДатаПоступления = Выборка.ДатаПоступления;
		Если ЗначениеЗаполнено(Выборка.ДатаПоступления) Тогда
			Строка.Ожидание = Окр((ТекущаяДатаСеанса() - Выборка.ДатаПоступления) / 3600, 1);
		Иначе
			Строка.Ожидание = 0;
		КонецЕсли;
	КонецЦикла;
	Таблица.Сортировать("Приоритет Убыв, Ранг Убыв, ДатаПоступления");
	Строки = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Элемент = Новый Структура("Номер, Канал, Контрагент, Категория, Приоритет, Тональность, Исполнитель, Статус, Уровень, Тема, Ожидание, Ссылка");
		ЗаполнитьЗначенияСвойств(Элемент, Строка);
		Строки.Добавить(Элемент);
	КонецЦикла;
	Возврат Строки;
	
КонецФункции

Функция КоличествоПоступивших(Начало)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Обращение.Ссылка) КАК Количество
	|ИЗ
	|	Документ.ИОО_Обращение КАК Обращение
	|ГДЕ
	|	НЕ Обращение.ПометкаУдаления
	|	И Обращение.ДатаПоступления >= &Начало
	|	И Обращение.Метка <> ""НАГРУЗКА""";
	Запрос.УстановитьПараметр("Начало", Начало);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	Возврат 0;
	
