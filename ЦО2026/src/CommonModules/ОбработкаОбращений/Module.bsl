// Контекст вызова модели: обращение, назначение и сведения об обезличивании для журнала.
Функция КонтекстВызова(Обращение, Назначение, Обезличенный)

	Результат = Новый Структура;
	Результат.Вставить("Обращение", Обращение);
	Результат.Вставить("Назначение", Назначение);
	Результат.Вставить("Обезличено", Обезличенный.Режим <> Перечисления.ИОО_РежимыОбезличивания.Выключено);
	Результат.Вставить("УтечекНайдено", Обезличенный.Утечек > 0);
	Результат.Вставить("РежимОбезличивания", Обезличенный.Режим);
	Возврат Результат;

КонецФункции

Функция НайтиПоВнешнемуИдентификатору(Идентификатор)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Обращение.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ИОО_Обращение КАК Обращение
	|ГДЕ
	|	Обращение.ВнешнийИдентификатор = &Идентификатор
	|	И НЕ Обращение.ПометкаУдаления";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Документы.ИОО_Обращение.ПустаяСсылка();
	
КонецФункции

Функция НайтиИлиСоздатьКонтрагента(Имя, Почта, Телефон, ИНН)
	
	Если Не ПустаяСтрока(Почта) Тогда
		Найденный = НайтиКонтрагентаПоРеквизиту("ЭлектроннаяПочта", Почта);
		Если ЗначениеЗаполнено(Найденный) Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЕсли;
	Если Не ПустаяСтрока(ИНН) Тогда
		Найденный = НайтиКонтрагентаПоРеквизиту("ИНН", ИНН);
		Если ЗначениеЗаполнено(Найденный) Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЕсли;
	Если Не ПустаяСтрока(Имя) Тогда
		Найденный = Справочники.Контрагенты.НайтиПоНаименованию(Имя, Истина);
		Если ЗначениеЗаполнено(Найденный) Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(Имя) И ПустаяСтрока(Почта) Тогда
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	Элемент = Справочники.Контрагенты.СоздатьЭлемент();
	Элемент.Наименование = ?(ПустаяСтрока(Имя), Почта, Имя);
	Элемент.ЭлектроннаяПочта = Лев(Почта, 150);
	Элемент.Телефон = Лев(Телефон, 30);
	Элемент.ИНН = Лев(ИНН, 12);
	Элемент.Записать();
	Возврат Элемент.Ссылка;
	
КонецФункции

Функция НайтиКонтрагентаПоРеквизиту(ИмяРеквизита, Значение)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты." + ИмяРеквизита + " = &Значение
	|	И НЕ Контрагенты.ПометкаУдаления";
	Запрос.УстановитьПараметр("Значение", Значение);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Контрагенты.ПустаяСсылка();
	
КонецФункции

Функция СпособПоПлану(План)
	
	Если План.Письмо И План.Публиковать Тогда
		Возврат Справочники.ИОО_СпособыОтвета.ПочтаИФорма;
	ИначеЕсли План.Письмо Тогда
		Возврат Справочники.ИОО_СпособыОтвета.ЭлектроннаяПочта;
	ИначеЕсли План.Публиковать Тогда
		Возврат Справочники.ИОО_СпособыОтвета.ПубликацияВФорме;
	КонецЕсли;
	Возврат Справочники.ИОО_СпособыОтвета.СообщеноПоЗвонку;
	
КонецФункции

Функция ОписаниеДоставки(План, Номер, Адрес)
	
	Части = Новый Массив;
	Если План.Письмо Тогда
		Части.Добавить("письмо отправлено на " + Адрес);
	КонецЕсли;
	Если План.Публиковать Тогда
		Части.Добавить("ответ опубликован для веб-формы, номер " + Номер);
	КонецЕсли;
	Если План.Звонок Тогда
		Части.Добавить("зафиксировано, что ответ сообщен клиенту по звонку");
	КонецЕсли;
	Если Части.Количество() = 0 Тогда
		Возврат "Ответ сохранен.";
	КонецЕсли;
	Возврат "Обращение " + Номер + ": " + СтрСоединить(Части, "; ") + ".";
	
КонецФункции

