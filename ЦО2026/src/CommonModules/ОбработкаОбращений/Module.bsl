// Классификация, приоритет, назначение и ответ.
// Модель возвращает тему, срочность текста и тон. Итоговый приоритет и исполнителя считает 1С.

Функция ПринятьВходящее(Данные) Экспорт
	
	Результат = Новый Структура("Успех, Номер, Текст, Повтор, Ссылка", Ложь, "", "", Ложь, Документы.ИОО_Обращение.ПустаяСсылка());
	Текст = "";
	Если Данные.Свойство("Текст") И Данные.Текст <> Неопределено Тогда
		Текст = СокрЛП(Строка(Данные.Текст));
	КонецЕсли;
	Если ПустаяСтрока(Текст) Тогда
		Результат.Текст = "Пустое обращение не принято.";
		Возврат Результат;
	КонецЕсли;
	
	ВнешнийИдентификатор = ЗначениеСтруктуры(Данные, "ВнешнийИдентификатор");
	Если Не ПустаяСтрока(ВнешнийИдентификатор) Тогда
		Существующее = НайтиПоВнешнемуИдентификатору(ВнешнийИдентификатор);
		Если ЗначениеЗаполнено(Существующее) Тогда
			Результат.Успех = Истина;
			Результат.Повтор = Истина;
			Результат.Ссылка = Существующее;
			Результат.Номер = Существующее.Номер;
			Результат.Текст = "Обращение " + Существующее.Номер + " уже есть, повтор не создан.";
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	Если Данные.Свойство("Контрагент") И ЗначениеЗаполнено(Данные.Контрагент) Тогда
		Контрагент = Данные.Контрагент;
	Иначе
		Контрагент = НайтиИлиСоздатьКонтрагента(
			ЗначениеСтруктуры(Данные, "ИмяКонтрагента"),
			ЗначениеСтруктуры(Данные, "УдалитьАдресОтвета"),
			ЗначениеСтруктуры(Данные, "Телефон"),
			ЗначениеСтруктуры(Данные, "ИНН"));
	КонецЕсли;
	Договорные = АктивныйДоговор(Контрагент);
	
	Документ = Документы.ИОО_Обращение.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.ДатаПоступления = Документ.Дата;
	Документ.Канал = Данные.Канал;
	Если Данные.Свойство("Источник") И ЗначениеЗаполнено(Данные.Источник) Тогда
		Документ.Источник = Данные.Источник;
	КонецЕсли;
	Документ.Контрагент = Контрагент;
	Документ.Договор = Договорные.Договор;
	Документ.УровеньКонтрагента = Договорные.Уровень;
	Документ.Тема = Лев(ЗначениеСтруктуры(Данные, "Тема"), 200);
	Документ.Текст = Текст;
	Документ.УдалитьАдресОтвета = Лев(ЗначениеСтруктуры(Данные, "УдалитьАдресОтвета"), 150);
	Документ.УдалитьВнешнийИдентификатор = Лев(ВнешнийИдентификатор, 180);
	Документ.Статус = Справочники.ИОО_СтатусыОбращений.Новое;
	Документ.СтатусВерификации = Справочники.ИОО_СтатусыВерификации.НеПроверено;
	Документ.УдалитьПояснениеПриоритета = Договорные.Пояснение;
	Документ.Записать();
	
	Результат.Успех = Истина;
	Результат.Ссылка = Документ.Ссылка;
	Результат.Номер = Документ.Номер;
	Результат.Текст = "Принято обращение " + Документ.Номер + ". " + Договорные.Пояснение;
	Возврат Результат;
	
КонецФункции

Функция Классифицировать(Ссылка) Экспорт
	
	Результат = Новый Структура("Успех, Текст", Ложь, "");
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Результат.Текст = "Не выбрано обращение.";
		Возврат Результат;
	КонецЕсли;
	
	Документ = Ссылка.ПолучитьОбъект();
	Если ПустаяСтрока(СокрЛП(Документ.Текст)) Тогда
		Результат.Текст = "В обращении пустой текст: классифицировать нечего.";
		Возврат Результат;
	КонецЕсли;
	Категории = СписокКатегорий();
	Если Категории.Количество() = 0 Тогда
		Результат.Текст = "Не заполнены категории обращений. Сначала загрузите демонстрационные данные.";
		Возврат Результат;
	КонецЕсли;
	
	ИсходныйТекст = Документ.Текст;
	Настройки = ИнтеграцияLLM.ПараметрыПодключения();
	ПромптДанные = ИнтеграцияLLM.СобратьПользовательскийПромпт(Ссылка, Настройки.Профиль);

	Контекст = КонтекстВызова(Ссылка, Перечисления.ИОО_ТипыЗадачLLM.Классификация, ПромптДанные);
	ОтветМодели = ИнтеграцияLLM.ВызватьМодель(СистемныйПромпт(Категории), ПромптДанные.Текст, Контекст);
	Если Не ОтветМодели.Успех Тогда
		ЗафиксироватьОшибкуМодели(Документ, ОтветМодели.ТекстОшибки);
		Результат.Текст = ОтветМодели.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	Если ОтветМодели.Обрезан Тогда
		ЗафиксироватьОшибкуМодели(Документ, "Ответ модели обрезан по лимиту токенов. Увеличьте максимум токенов и повторите.");
		Результат.Текст = Документ.КомментарийОшибки;
		Возврат Результат;
	КонецЕсли;
	
	Разбор = ИнтеграцияLLM.ИзвлечьОбъектJSON(ОтветМодели.Текст);
	Если ТипЗнч(Разбор) <> Тип("Структура") Тогда
		ЗафиксироватьОшибкуМодели(Документ, "Модель не вернула JSON. Ответ сохранен в журнале вызовов.");
		Результат.Текст = Документ.КомментарийОшибки;
		Возврат Результат;
	КонецЕсли;
	
	Категория = НайтиКатегорию(Категории, СтрокаПоля(Разбор, "category", "категория"));
	Если Не ЗначениеЗаполнено(Категория) Тогда
		Категория = НайтиКатегорию(Категории, "Прочее");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Категория) Тогда
		ЗафиксироватьОшибкуМодели(Документ, "Модель вернула категорию вне списка, а категория «Прочее» не заведена.");
		Результат.Текст = Документ.КомментарийОшибки;
		Возврат Результат;
	КонецЕсли;
	
	Срочность = ОграничитьЧисло(ЧислоПоля(Разбор, "urgency", "срочность"), 1, 5);
	Тональность = ТональностьПоТексту(СтрокаПоля(Разбор, "sentiment", "тональность"));
	Договорные = АктивныйДоговор(Документ.Контрагент);
	Расчет = РассчитатьПриоритет(Срочность, Тональность, Договорные.Уровень);
	Назначение = ПодобратьИсполнителя(Категория, Ссылка);
	
	Документ.Категория = Категория;
	Документ.ОценкаПриоритета = Срочность;
	Документ.УровеньЭмоциональности = Тональность;
	Документ.Приоритет = Расчет.Приоритет;
	Документ.УдалитьПояснениеПриоритета = Расчет.Пояснение + Символы.ПС + СтрокаПоля(Разбор, "explanation", "пояснение");
	Документ.Договор = Договорные.Договор;
	Документ.УровеньКонтрагента = Договорные.Уровень;
	Документ.УдалитьКатегорияИИ = Категория;
	Документ.УдалитьСрочностьИИ = Срочность;
	Документ.УдалитьУровеньЭмоциональностиИИ = Тональность;
	Документ.УдалитьПриоритетИИ = Расчет.Приоритет;
	Документ.Исполнитель = Назначение.Исполнитель;
	Документ.УдалитьИсполнительИИ = Назначение.Исполнитель;
	Документ.УдалитьОценкаНазначения = Назначение.Оценка;
	Документ.УдалитьПояснениеНазначения = Назначение.Пояснение;
	Документ.ДатаКлассификации = ТекущаяДатаСеанса();
	Документ.СтатусВерификации = Справочники.ИОО_СтатусыВерификации.НеПроверено;
	Документ.КомментарийОшибки = "";
	Документ.УдалитьХешТекста = ХешТекста(ИсходныйТекст);
	Если ЗначениеЗаполнено(Назначение.Исполнитель) Тогда
		Документ.Статус = Справочники.ИОО_СтатусыОбращений.Назначено;
		Документ.ДатаНазначения = Документ.ДатаКлассификации;
	Иначе
		Документ.Статус = Справочники.ИОО_СтатусыОбращений.Классифицировано;
	КонецЕсли;
	Документ.Записать();
	
	ТекстРезультата = "Категория: " + Категория.Наименование + ". Приоритет " + Формат(Расчет.Приоритет, "ЧГ=0")
		+ ". " + Назначение.Пояснение;
	Если Категория.ТребуетЧерновик Тогда
		Черновик = СформироватьЧерновик(Ссылка);
		ТекстРезультата = ТекстРезультата + Символы.ПС + Черновик.Текст;
	КонецЕсли;
	Результат.Успех = Истина;
	Результат.Текст = ТекстРезультата;
	Возврат Результат;
	
КонецФункции

Функция Подтвердить(Ссылка, Категория, Тональность, Приоритет, Исполнитель, Черновик) Экспорт
	
	Результат = Новый Структура("Успех, Текст", Ложь, "");
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Результат.Текст = "Не выбрано обращение.";
		Возврат Результат;
	КонецЕсли;
	Документ = Ссылка.ПолучитьОбъект();
	БылоИсправление = Категория <> Документ.УдалитьКатегорияИИ
		Или Тональность <> Документ.УдалитьУровеньЭмоциональностиИИ
		Или Приоритет <> Документ.УдалитьПриоритетИИ
		Или Исполнитель <> Документ.УдалитьИсполнительИИ;
	ОтветИИ = ОписаниеРешения(Документ.УдалитьКатегорияИИ, Документ.УровеньЭмоциональностиИИ, Документ.УдалитьПриоритетИИ, Документ.УдалитьИсполнительИИ);
	Документ.Категория = Категория;
	Документ.УровеньЭмоциональности = Тональность;
	Документ.Приоритет = ОграничитьЧисло(Приоритет, 1, 5);
	Документ.Исполнитель = Исполнитель;
	Если Не ПустаяСтрока(СокрЛП(Черновик)) Тогда
		Документ.УдалитьЧерновикОтвета = Черновик;
	КонецЕсли;
	Если ЗначениеЗаполнено(Исполнитель) И Не ЗначениеЗаполнено(Документ.ДатаНазначения) Тогда
		Документ.ДатаНазначения = ТекущаяДатаСеанса();
	КонецЕсли;
	Если БылоИсправление Тогда
		Документ.СтатусВерификации = Справочники.ИОО_СтатусыВерификации.Исправлено;
		ЗаписатьИсправление(Документ, ОтветИИ);
	Иначе
		Документ.СтатусВерификации = Справочники.ИОО_СтатусыВерификации.Подтверждено;
	КонецЕсли;
	Если Документ.Статус = Справочники.ИОО_СтатусыОбращений.Новое
		Или Документ.Статус = Справочники.ИОО_СтатусыОбращений.ОшибкаИИ Тогда
		Документ.Статус = ?(ЗначениеЗаполнено(Исполнитель),
			Справочники.ИОО_СтатусыОбращений.Назначено,
			Справочники.ИОО_СтатусыОбращений.Классифицировано);
	КонецЕсли;
	Документ.Записать();
	Результат.Успех = Истина;
	Результат.Текст = ?(БылоИсправление,
		"Исправление сохранено и будет использовано в следующих промптах.",
		"Классификация подтверждена без изменений.");
	Возврат Результат;
	
КонецФункции

Функция СформироватьЧерновик(Ссылка) Экспорт
	
	Результат = Новый Структура("Успех, Текст", Ложь, "");
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Результат.Текст = "Не выбрано обращение.";
		Возврат Результат;
	КонецЕсли;
	Документ = Ссылка.ПолучитьОбъект();
	Если Не ЗначениеЗаполнено(Документ.Категория) Или Не Документ.Категория.ТребуетЧерновик Тогда
		Результат.Текст = "Черновик по номенклатуре формируется для категории «Консультация по запчастям».";
		Возврат Результат;
	КонецЕсли;

	Настройки = ИнтеграцияLLM.ПараметрыПодключения();
	Если Не ИнтеграцияLLM.ФункцияДоступна(Настройки.Профиль, Перечисления.ИОО_ФункцииПрофиля.ЧерновикОтвета) Тогда
		Результат.Текст = "Функция «Черновик ответа» недоступна в профиле «" + Строка(Настройки.Профиль) + "».";
		Возврат Результат;
	КонецЕсли;

	Позиции = ПодобратьНоменклатуру(Документ.Текст, Документ.УдалитьПояснениеПриоритета);
	Список = "";
	Для Каждого Позиция Из Позиции Цикл
		Список = Список + "- " + Позиция.Артикул + " | " + Позиция.Наименование
			+ " | остаток " + Формат(Позиция.Остаток, "ЧГ=0")
			+ " | цена " + Формат(Позиция.Цена, "ЧДЦ=2; ЧГ=0")
			+ " | " + Позиция.Описание + Символы.ПС;
	КонецЦикла;
	Если ПустаяСтрока(Список) Тогда
		Список = "В справочнике номенклатуры нет позиций.";
	КонецЕсли;
	
	Системный = "Ты консультант по запчастям компании ТехноСервис. Напиши черновик ответа клиенту на русском языке. "
		+ "Используй только позиции из списка. Не выдумывай артикулы, остатки и цены. "
		+ "Если точной позиции нет, так и напиши и предложи ближайшую из списка. "
		+ "Верни JSON без markdown: {""reply"":""текст ответа""}.";
	ПромптДанные = ИнтеграцияLLM.СобратьПользовательскийПромпт(Ссылка, Настройки.Профиль);
	Пользовательский = ПромптДанные.Текст + Символы.ПС + Символы.ПС
		+ "Номенклатура:" + Символы.ПС + Список;
	ОтветМодели = ИнтеграцияLLM.ВызватьМодель(Системный, Пользовательский,
		КонтекстВызова(Ссылка, Перечисления.ИОО_ТипыЗадачLLM.ЧерновикОтвета, ПромптДанные));
	Если Не ОтветМодели.Успех Тогда
		Документ.КомментарийОшибки = ОтветМодели.ТекстОшибки;
		Документ.Записать();
		Результат.Текст = ОтветМодели.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	Разбор = ИнтеграцияLLM.ИзвлечьОбъектJSON(ОтветМодели.Текст);
	ТекстЧерновика = "";
	Если ТипЗнч(Разбор) = Тип("Структура") Тогда
		ТекстЧерновика = СтрокаПоля(Разбор, "reply", "ответ");
	КонецЕсли;
	Если ПустаяСтрока(ТекстЧерновика) Тогда
		ТекстЧерновика = СокрЛП(ОтветМодели.Текст);
	КонецЕсли;
	Если Настройки.ВосстанавливатьТокены Тогда
		ТекстЧерновика = Обезличивание.Восстановить(ТекстЧерновика, Ссылка);
	КонецЕсли;
	Документ.УдалитьЧерновикОтвета = ТекстЧерновика;
	Если Документ.Статус <> Справочники.ИОО_СтатусыОбращений.ОтветОтправлен
		И Документ.Статус <> Справочники.ИОО_СтатусыОбращений.Закрыто Тогда
		Документ.Статус = Справочники.ИОО_СтатусыОбращений.ОтветПодготовлен;
	КонецЕсли;
	Документ.КомментарийОшибки = "";
	Документ.Записать();
	Результат.Успех = Истина;
	Результат.Текст = "Черновик подготовлен по " + Формат(Позиции.Количество(), "ЧГ=0") + " позициям номенклатуры.";
	Возврат Результат;
	
КонецФункции

Функция ОтправитьОтвет(Ссылка, ТекстОтвета, ТакжеНаПочту) Экспорт
	
	Результат = Новый Структура("Успех, Текст", Ложь, "");
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Результат.Текст = "Не выбрано обращение.";
		Возврат Результат;
	КонецЕсли;
	Документ = Ссылка.ПолучитьОбъект();
	Текст = СокрЛП(ТекстОтвета);
	Если ПустаяСтрока(Текст) Тогда
		Текст = СокрЛП(Документ.УдалитьЧерновикОтвета);
	КонецЕсли;
	Если ПустаяСтрока(Текст) Тогда
		Результат.Текст = "Нет текста ответа. Подготовьте черновик или впишите ответ вручную.";
		Возврат Результат;
	КонецЕсли;
	
	План = ПланОтвета(Документ.Канал, Документ.УдалитьАдресОтвета, ТакжеНаПочту);
	Если Документ.Канал = Справочники.ИОО_КаналыОбращений.Почта И Не План.Письмо Тогда
		Результат.Текст = "У обращения с почты нет адреса для ответа.";
		Возврат Результат;
	КонецЕсли;
	Если План.Письмо Тогда
		Тема = "Ответ по обращению " + Документ.Номер;
		Если Не ПустаяСтрока(Документ.Тема) Тогда
			Тема = "Re: " + Документ.Тема;
		КонецЕсли;
		Отправка = РаботаСПочтой.ОтправитьПисьмо(Неопределено, Документ.УдалитьАдресОтвета, Тема, Текст);
		Если Не Отправка.Успех Тогда
			Документ.КомментарийОшибки = Отправка.Текст;
			Документ.Записать();
			Результат.Текст = Отправка.Текст;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Документ.ТекстОтвета = Текст;
	Документ.ДатаОтвета = ТекущаяДатаСеанса();
	Документ.Статус = Справочники.ИОО_СтатусыОбращений.ОтветОтправлен;
	Документ.КомментарийОшибки = "";
	Документ.СпособОтвета = СпособПоПлану(План);
	Документ.Записать();
	Результат.Успех = Истина;
	Результат.Текст = ОписаниеДоставки(План, Документ.Номер, Документ.УдалитьАдресОтвета);
	Возврат Результат;
	
КонецФункции

Функция СтатусДляПубликации(Номер) Экспорт
	
	Карточка = Новый Структура("Найдено, Данные", Ложь, Новый Структура("found, number, status, answer", Ложь, Номер, "", ""));
	Если ПустаяСтрока(СокрЛП(Номер)) Тогда
		Возврат Карточка;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Обращение.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ИОО_Обращение КАК Обращение
	|ГДЕ
	|	Обращение.Номер = &Номер
	|	И НЕ Обращение.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Обращение.Дата УБЫВ";
	Запрос.УстановитьПараметр("Номер", СокрЛП(Номер));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Карточка;
	КонецЕсли;
	Объект = Выборка.Ссылка.ПолучитьОбъект();
	ОтветКлиенту = "";
	Если Объект.Статус = Справочники.ИОО_СтатусыОбращений.ОтветОтправлен
		Или Объект.Статус = Справочники.ИОО_СтатусыОбращений.Закрыто Тогда
		ОтветКлиенту = Объект.ТекстОтвета;
	КонецЕсли;
	Карточка.Найдено = Истина;
	Карточка.Данные = Новый Структура("found, number, status, answer", Истина, Объект.Номер, Строка(Объект.Статус), ОтветКлиенту);
	Возврат Карточка;
	
КонецФункции

