Процедура ВывестиСтроку(Таб, НомерСтроки, Слева, Справа)
	
	Таб.Область(НомерСтроки, 1).Текст = Строка(Слева);
	Таб.Область(НомерСтроки, 2).Текст = Строка(Справа);
	
КонецПроцедуры

Процедура ЗафиксироватьОшибкуМодели(Документ, Текст)

	// Технический сбой модели не должен откатывать уже принятое решение оператора.
	Если Документ.Статус = Справочники.ИОО_СтатусыОбращений.Новое
		Или Документ.Статус = Справочники.ИОО_СтатусыОбращений.Классифицировано Тогда
		Документ.Статус = Справочники.ИОО_СтатусыОбращений.ОшибкаИИ;
	КонецЕсли;
	Документ.КомментарийОшибки = Текст;
	Документ.Записать();

КонецПроцедуры

Процедура ЗаписатьИсправление(Документ, ОтветИИ)
	
	Исправленный = ОписаниеРешения(Документ.Категория, Документ.УровеньЭмоциональности, Документ.Приоритет, Документ.Исполнитель);
	Обезличенный = Обезличивание.Обезличить(Документ.Тема + Символы.ПС + Документ.Текст, Документ.Ссылка);
	Текст = Лев(Обезличенный.Текст, 1000);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Исправления.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ИсправленияКлассификации КАК Исправления
	|ГДЕ
	|	Исправления.ТекстОбращения = &Текст
	|	И Исправления.ИсправленныйОтвет = &Ответ";
	Запрос.УстановитьПараметр("Текст", Текст);
	Запрос.УстановитьПараметр("Ответ", Исправленный);
	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;
	Запись = РегистрыСведений.ИсправленияКлассификации.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = Строка(Новый УникальныйИдентификатор);
	Запись.ИспользоватьВПромпте = Истина;
	Запись.Дата = ТекущаяДатаСеанса();
	Запись.ИОО_Обращение = Документ.Ссылка;
	Запись.ТекстОбращения = Текст;
	Запись.ОтветИИ = ОтветИИ;
	Запись.ИсправленныйОтвет = Исправленный;
	Запись.Записать();
	
КонецПроцедуры

Функция ОписаниеРешения(Категория, Тональность, Приоритет, Исполнитель)
	
	Возврат "категория=" + Строка(Категория) + "; тон=" + Строка(Тональность)
		+ "; приоритет=" + Формат(Приоритет, "ЧГ=0") + "; исполнитель="
		+ ?(ЗначениеЗаполнено(Исполнитель), "<ИСПОЛНИТЕЛЬ>", "");
	
КонецФункции

// Значения полей обращения для сборки промпта.
//
// Параметры:
//   Обращение - ДокументСсылка.ИОО_Обращение - обращение.
//
// Возвращаемое значение:
//   Соответствие - путь поля (Строка) -> значение (Строка).
//
Функция ЗначенияПолейОбращения(Обращение) Экспорт

	Значения = Новый Соответствие;
	Если Не ЗначениеЗаполнено(Обращение) Тогда
		Возврат Значения;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Обращение.Тема КАК Тема,
	|	Обращение.Текст КАК Текст,
	|	Обращение.Канал КАК Канал,
	|	Обращение.Источник КАК Источник,
	|	Обращение.ДатаПоступления КАК ДатаПоступления,
	|	Обращение.Приоритет КАК Приоритет,
	|	Обращение.Категория КАК Категория,
	|	Обращение.УровеньЭмоциональности КАК УровеньЭмоциональности,
	|	ЕСТЬNULL(Обращение.Контрагент.Наименование, """") КАК Контрагент,
	|	ЕСТЬNULL(Обращение.Контрагент.ИНН, """") КАК КонтрагентИНН,
	|	ЕСТЬNULL(Обращение.Контрагент.Телефон, """") КАК КонтрагентТелефон,
	|	ЕСТЬNULL(Обращение.Контрагент.ЭлектроннаяПочта, """") КАК КонтрагентПочта,
	|	ЕСТЬNULL(Обращение.Договор.НомерДоговора, """") КАК НомерДоговора,
	|	ЕСТЬNULL(Обращение.УдалитьАдресОтвета, """") КАК АдресОтвета,
	|	Обращение.УровеньКонтрагента КАК УровеньКонтрагента
	|ИЗ
	|	Документ.ИОО_Обращение КАК Обращение
	|ГДЕ
	|	Обращение.Ссылка = &Обращение";
	Запрос.УстановитьПараметр("Обращение", Обращение);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Значения;
	КонецЕсли;
	Значения.Вставить("Тема", Выборка.Тема);
	Значения.Вставить("Текст", Выборка.Текст);
	Значения.Вставить("Канал", Строка(Выборка.Канал));
	Значения.Вставить("Источник", Строка(Выборка.Источник));
	Значения.Вставить("ДатаПоступления", Формат(Выборка.ДатаПоступления, "ДЛФ=DT"));
	Значения.Вставить("Приоритет", Формат(Выборка.Приоритет, "ЧГ=0"));
	Значения.Вставить("Категория", Строка(Выборка.Категория));
	Значения.Вставить("УровеньЭмоциональности", Строка(Выборка.УровеньЭмоциональности));
	Значения.Вставить("Контрагент.Наименование", Выборка.Контрагент);
	Значения.Вставить("Контрагент.ИНН", Выборка.КонтрагентИНН);
	Значения.Вставить("Контрагент.Телефон", Выборка.КонтрагентТелефон);
	Значения.Вставить("Контрагент.ЭлектроннаяПочта", Выборка.КонтрагентПочта);
	Значения.Вставить("Договор.НомерДоговора", Выборка.НомерДоговора);
	Значения.Вставить("АдресОтвета", Выборка.АдресОтвета);
	Значения.Вставить("УровеньКонтрагента", Строка(Выборка.УровеньКонтрагента));
	Возврат Значения;

КонецФункции

