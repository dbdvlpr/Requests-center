Функция УзкиеМеста()
	
	Пункты = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Обращение.Ссылка) КАК Количество
	|ИЗ
	|	Документ.ИОО_Обращение КАК Обращение
	|ГДЕ
	|	НЕ Обращение.ПометкаУдаления
	|	И Обращение.Метка <> ""НАГРУЗКА""
	|	И Обращение.Исполнитель = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|	И Обращение.Статус <> ЗНАЧЕНИЕ(Справочник.ИОО_СтатусыОбращений.ОтветОтправлен)
	|	И Обращение.Статус <> ЗНАЧЕНИЕ(Справочник.ИОО_СтатусыОбращений.Закрыто)";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Количество > 0 Тогда
		Пункты.Добавить("Без исполнителя: " + Формат(Выборка.Количество, "ЧГ=0") + ".");
	КонецЕсли;
	Очереди = ОчередиИсполнителей();
	Если Очереди.Количество() > 0 Тогда
		Пункты.Добавить("Самая длинная очередь: " + Очереди[0].Имя + ", " + Формат(Очереди[0].Количество, "ЧГ=0") + " открытых.");
	КонецЕсли;
	Если Пункты.Количество() = 0 Тогда
		Пункты.Добавить("Очередь распределена, зависших обращений нет.");
	КонецЕсли;
	Возврат Пункты;
	
