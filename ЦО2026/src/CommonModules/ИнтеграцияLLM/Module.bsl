// Универсальный вызов модели: YandexGPT, GigaChat и любой OpenAI-совместимый HTTP JSON.
// Параметры берутся из активного профиля LLM и его провайдера, ключ в журнал не записывается.

Функция КлючЗадан() Экспорт
	
	Возврат Не ПустаяСтрока(СокрЛП(ПараметрыПодключения().Ключ));
	
КонецФункции

// Возвращает профиль LLM, используемый для вызовов модели.
//
// Возвращаемое значение:
//  СправочникСсылка.ИОО_ПрофилиLLM - профиль из константы, иначе профиль по умолчанию,
//    иначе первый активный; пустая ссылка, если профили не заведены.
//
Функция АктивныйПрофиль() Экспорт
	
	Профиль = Константы.АктивныйПрофильLLM.Получить();
	Если ЗначениеЗаполнено(Профиль) Тогда
		Возврат Профиль;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Профили.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИОО_ПрофилиLLM КАК Профили
	|ГДЕ
	|	НЕ Профили.ПометкаУдаления
	|	И НЕ Профили.ЭтоГруппа
	|	И Профили.Провайдер.Активен
	|
	|УПОРЯДОЧИТЬ ПО
	|	Профили.ПрофильПоУмолчанию УБЫВ,
	|	Профили.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.ИОО_ПрофилиLLM.ПустаяСсылка();
	
КонецФункции

// Возвращает параметры подключения к модели из активного профиля и его провайдера.
//
// Возвращаемое значение:
//  Структура - параметры подключения:
//   * Профиль - СправочникСсылка.ИОО_ПрофилиLLM - выбранный профиль;
//   * Провайдер - СправочникСсылка.ИОО_ПровайдерыLLM - провайдер профиля;
//   * Формат - Строка - формат протокола: yandex, gigachat или openai;
//   * Ключ - Строка - ключ API профиля;
//   * Каталог - Строка - идентификатор каталога YandexGPT;
//   * Модель - Строка - имя модели;
//   * Адрес - Строка - адрес API;
//   * АдресАвторизации - Строка - адрес получения токена GigaChat;
//   * Схема - Строка - схема авторизации;
//   * Таймаут - Число - таймаут запроса в секундах;
//   * МаксимумТокенов - Число - ограничение длины ответа;
//   * Температура - Число - температура генерации;
//   * ОбластьGigaChat - Строка - область доступа GigaChat;
//   * КоличествоПримеров - Число - сколько исправлений добавлять в промпт;
//   * Обезличивать - Булево - признак обезличивания текста перед отправкой.
//
Функция ПараметрыПодключения() Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("Профиль", Справочники.ИОО_ПрофилиLLM.ПустаяСсылка());
	Параметры.Вставить("Провайдер", Справочники.ИОО_ПровайдерыLLM.ПустаяСсылка());
	Параметры.Вставить("Формат", "yandex");
	Параметры.Вставить("Ключ", "");
	Параметры.Вставить("Каталог", "");
	Параметры.Вставить("Модель", "");
	Параметры.Вставить("Адрес", "");
	Параметры.Вставить("АдресАвторизации", "");
	Параметры.Вставить("Схема", "Api-Key");
	Параметры.Вставить("Таймаут", 90);
	Параметры.Вставить("МаксимумТокенов", 2000);
	Параметры.Вставить("Температура", 0.1);
	Параметры.Вставить("ОбластьGigaChat", "GIGACHAT_API_PERS");
	Параметры.Вставить("КоличествоПримеров", 4);
	Параметры.Вставить("Обезличивать", Ложь);
	
	Профиль = АктивныйПрофиль();
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		Параметры.Модель = "yandexgpt/latest";
		Возврат Параметры;
	КонецЕсли;
	Параметры.Профиль = Профиль;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Профили.КлючAPI КАК Ключ,
	|	Профили.ИдентификаторКаталога КАК Каталог,
	|	Профили.Модель КАК Модель,
	|	Профили.Температура КАК Температура,
	|	Профили.МаксимумТокенов КАК МаксимумТокенов,
	|	Профили.ТаймаутСекунд КАК Таймаут,
	|	Профили.КоличествоПримеров КАК КоличествоПримеров,
	|	Профили.ОбезличиватьПередОтправкой КАК Обезличивать,
	|	Профили.Провайдер КАК Провайдер,
	|	Профили.Провайдер.ФорматПротокола КАК Формат,
	|	Профили.Провайдер.АдресAPI КАК Адрес,
	|	Профили.Провайдер.АдресАвторизации КАК АдресАвторизации,
	|	Профили.Провайдер.СхемаАвторизации КАК Схема,
	|	Профили.Провайдер.ОбластьДоступа КАК Область
	|ИЗ
	|	Справочник.ИОО_ПрофилиLLM КАК Профили
	|ГДЕ
	|	Профили.Ссылка = &Профиль";
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Параметры.Модель = "yandexgpt/latest";
		Возврат Параметры;
	КонецЕсли;
	
	Параметры.Провайдер = Выборка.Провайдер;
	Параметры.Ключ = СокрЛП(Выборка.Ключ);
	Параметры.Каталог = СокрЛП(Выборка.Каталог);
	Параметры.Модель = СокрЛП(Выборка.Модель);
	Параметры.Адрес = СокрЛП(Выборка.Адрес);
	Параметры.АдресАвторизации = СокрЛП(Выборка.АдресАвторизации);
	Параметры.Схема = СокрЛП(Выборка.Схема);
	Параметры.ОбластьGigaChat = СокрЛП(Выборка.Область);
	Параметры.Обезличивать = Выборка.Обезличивать;
	Параметры.Формат = НРег(СокрЛП(Выборка.Формат));
	Если ПустаяСтрока(Параметры.Формат) Тогда
		Параметры.Формат = "yandex";
	КонецЕсли;
	Если Выборка.Таймаут > 0 Тогда
		Параметры.Таймаут = Выборка.Таймаут;
	КонецЕсли;
	Если Выборка.МаксимумТокенов > 0 Тогда
		Параметры.МаксимумТокенов = Выборка.МаксимумТокенов;
	КонецЕсли;
	Если Выборка.Температура >= 0 И Выборка.Температура <= 1 Тогда
		Параметры.Температура = Выборка.Температура;
	КонецЕсли;
	Если Выборка.КоличествоПримеров > 0 Тогда
		Параметры.КоличествоПримеров = Мин(Выборка.КоличествоПримеров, 8);
	КонецЕсли;
	
	Если ПустаяСтрока(Параметры.ОбластьGigaChat) Тогда
		Параметры.ОбластьGigaChat = "GIGACHAT_API_PERS";
	КонецЕсли;
	Если ПустаяСтрока(Параметры.Схема) Тогда
		Параметры.Схема = ?(Параметры.Формат = "yandex", "Api-Key", "Bearer");
	КонецЕсли;
	Если ПустаяСтрока(Параметры.Модель) Тогда
		Если Параметры.Формат = "gigachat" Тогда
			Параметры.Модель = "GigaChat";
		ИначеЕсли Параметры.Формат = "openai" Тогда
			Параметры.Модель = "model";
		Иначе
			Параметры.Модель = "yandexgpt/latest";
		КонецЕсли;
	КонецЕсли;
	Если Параметры.Формат = "gigachat" Тогда
		Если ПустаяСтрока(Параметры.Адрес) Тогда
			Параметры.Адрес = "https://gigachat.devices.sberbank.ru/api/v1/chat/completions";
		КонецЕсли;
		Если ПустаяСтрока(Параметры.АдресАвторизации) Тогда
			Параметры.АдресАвторизации = "https://ngw.devices.sberbank.ru:9443/api/v2/oauth";
		КонецЕсли;
	КонецЕсли;
	
	Возврат Параметры;
	
КонецФункции

Функция ПроверитьСоединение() Экспорт
	
	Возврат ВызватьМодель(
		"Ответь строго одним JSON без markdown: {""статус"":""ok""}",
		"Проверка соединения.",
		Новый Структура("Назначение", Перечисления.ИОО_ТипыЗадачLLM.ПроверкаСоединения));
	
КонецФункции

Функция ВызватьМодель(СистемныйПромпт, ПользовательскийПромпт, Контекст) Экспорт
	
	Если Контекст = Неопределено Тогда
		Контекст = Новый Структура;
	КонецЕсли;
	
	Старт = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Параметры = ПараметрыПодключения();
	Результат = НовыйРезультатВызова(Параметры.Модель);
	Если Не Контекст.Свойство("Профиль") И ЗначениеЗаполнено(Параметры.Профиль) Тогда
		Контекст.Вставить("Профиль", Параметры.Профиль);
	КонецЕсли;
	
	Если ПустаяСтрока(Параметры.Ключ) Тогда
		Результат.ТекстОшибки = "Не задан ключ API. Откройте «Настройки подключения».";
		ЗавершитьВызов(Результат, Старт, СистемныйПромпт, ПользовательскийПромпт, Контекст);
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		Если Параметры.Формат = "gigachat" Тогда
			ВызватьGigaChat(Параметры, СистемныйПромпт, ПользовательскийПромпт, Результат);
		ИначеЕсли Параметры.Формат = "openai" Тогда
			ВызватьOpenAI(Параметры, СистемныйПромпт, ПользовательскийПромпт, Результат);
		Иначе
			ВызватьYandex(Параметры, СистемныйПромпт, ПользовательскийПромпт, Результат);
		КонецЕсли;
	Исключение
		Информация = ИнформацияОбОшибке();
		Результат.Успех = Ложь;
		Результат.ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(Информация);
		Результат.СыройОтвет = ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация);
	КонецПопытки;
	
	ЗавершитьВызов(Результат, Старт, СистемныйПромпт, ПользовательскийПромпт, Контекст);
	Возврат Результат;
	
КонецФункции

Функция ВJSON(Данные) Экспорт
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
	
КонецФункции

Функция ПрочитатьОбъектJSON(Текст) Экспорт
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Данные = ПрочитатьJSON(Чтение, Ложь);
		Чтение.Закрыть();
		Возврат Данные;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция ИзвлечьОбъектJSON(Текст) Экспорт
	
	Очищенный = СокрЛП(Текст);
	Если СтрНачинаетсяС(Очищенный, "```") Тогда
		Позиция = СтрНайти(Очищенный, Символы.ПС);
		Если Позиция > 0 Тогда
			Очищенный = СокрЛП(Сред(Очищенный, Позиция + 1));
		КонецЕсли;
		Если СтрЗаканчиваетсяНа(Очищенный, "```") Тогда
			Очищенный = СокрЛП(Лев(Очищенный, СтрДлина(Очищенный) - 3));
		КонецЕсли;
	КонецЕсли;
	Начало = СтрНайти(Очищенный, "{");
	Конец = 0;
	Для Индекс = 1 По СтрДлина(Очищенный) Цикл
		Если Сред(Очищенный, Индекс, 1) = "}" Тогда
			Конец = Индекс;
		КонецЕсли;
	КонецЦикла;
	Если Начало = 0 Или Конец < Начало Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ПрочитатьОбъектJSON(Сред(Очищенный, Начало, Конец - Начало + 1));
	
КонецФункции

Функция НовыйРезультатВызова(Модель)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Текст", "");
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("КодСостояния", 0);
	Результат.Вставить("ДлительностьМс", 0);
	Результат.Вставить("СыройОтвет", "");
	Результат.Вставить("Обрезан", Ложь);
	Результат.Вставить("Модель", Модель);
	Возврат Результат;
	
КонецФункции

Процедура ВызватьYandex(Параметры, СистемныйПромпт, ПользовательскийПромпт, Результат)
	
	Если ПустаяСтрока(Параметры.Каталог) И Не СтрНачинаетсяС(НРег(Параметры.Модель), "gpt://") Тогда
		Результат.ТекстОшибки = "Для YandexGPT укажите идентификатор каталога в настройках подключения.";
		Возврат;
	КонецЕсли;
	
	Если СтрНачинаетсяС(НРег(Параметры.Модель), "gpt://") Тогда
		АдресМодели = Параметры.Модель;
	Иначе
		АдресМодели = "gpt://" + Параметры.Каталог + "/" + Параметры.Модель;
	КонецЕсли;
	Результат.Модель = АдресМодели;
	
	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("role, text", "system", СистемныйПромпт));
	Сообщения.Добавить(Новый Структура("role, text", "user", ПользовательскийПромпт));
	Опции = Новый Структура;
	Опции.Вставить("stream", Ложь);
	Опции.Вставить("temperature", Параметры.Температура);
	Опции.Вставить("maxTokens", Формат(Параметры.МаксимумТокенов, "ЧГ=0"));
	Тело = Новый Структура;
	Тело.Вставить("modelUri", АдресМодели);
	Тело.Вставить("completionOptions", Опции);
	Тело.Вставить("messages", Сообщения);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Authorization", ЗаголовокКлюча(Параметры.Ключ, Параметры.Схема));
	Заголовки.Вставить("x-folder-id", ОчиститьЗначениеЗаголовка(Параметры.Каталог));
	
	Хост = "llm.api.cloud.yandex.net";
	Путь = "/foundationModels/v1/completion";
	Порт = 443;
	Защита = Истина;
	Если Не ПустаяСтрока(Параметры.Адрес) Тогда
		Части = РазобратьАдрес(Параметры.Адрес, "/foundationModels/v1/completion");
		Хост = Части.Хост;
		Путь = Части.Путь;
		Порт = Части.Порт;
		Защита = Части.Защита;
	КонецЕсли;
	
	Ответ = ОтправитьЗапрос(Хост, Порт, Путь, Заголовки, ВJSON(Тело), Параметры.Таймаут, Защита);
	ЗаполнитьПоHTTP(Результат, Ответ);
	Если Не Результат.Успех Тогда
		Возврат;
	КонецЕсли;
	
	Данные = ПрочитатьОбъектJSON(Ответ.Тело);
	Альтернатива = Неопределено;
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("result")
		И ТипЗнч(Данные.result) = Тип("Структура") И Данные.result.Свойство("alternatives")
		И ТипЗнч(Данные.result.alternatives) = Тип("Массив") И Данные.result.alternatives.Количество() > 0 Тогда
		Альтернатива = Данные.result.alternatives[0];
	КонецЕсли;
	Если ТипЗнч(Альтернатива) <> Тип("Структура") Или Не Альтернатива.Свойство("message") Тогда
		Результат.Успех = Ложь;
		Результат.ТекстОшибки = "YandexGPT вернул ответ без текста модели.";
		Возврат;
	КонецЕсли;
	Результат.Текст = Альтернатива.message.text;
	Статус = "";
	Если Альтернатива.Свойство("status") Тогда
		Статус = Строка(Альтернатива.status);
	КонецЕсли;
	Результат.Обрезан = СтрНайти(ВРег(Статус), "TRUNCATED") > 0
		Или (ЗначениеЗаполнено(Статус) И СтрНайти(ВРег(Статус), "FINAL") = 0);
	
КонецПроцедуры

Процедура ВызватьGigaChat(Параметры, СистемныйПромпт, ПользовательскийПромпт, Результат)
	
	Результат.Модель = Параметры.Модель;
	Токен = ТокенGigaChat(Параметры, Результат);
	Если ПустаяСтрока(Токен) Тогда
		Возврат;
	КонецЕсли;
	
	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("role, content", "system", СистемныйПромпт));
	Сообщения.Добавить(Новый Структура("role, content", "user", ПользовательскийПромпт));
	Тело = Новый Структура;
	Тело.Вставить("model", Параметры.Модель);
	Тело.Вставить("temperature", Параметры.Температура);
	Тело.Вставить("max_tokens", Параметры.МаксимумТокенов);
	Тело.Вставить("stream", Ложь);
	Тело.Вставить("messages", Сообщения);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Части = РазобратьАдрес(Параметры.Адрес, "/api/v1/chat/completions");
	Ответ = ОтправитьЗапрос(
		Части.Хост, Части.Порт, Части.Путь,
		Заголовки, ВJSON(Тело), Параметры.Таймаут, Части.Защита);
	ЗаполнитьПоHTTP(Результат, Ответ);
	Если Не Результат.Успех Тогда
		Если Результат.КодСостояния = 0 Тогда
			Результат.ТекстОшибки = Результат.ТекстОшибки
				+ " Для GigaChat в хранилище Windows должен быть установлен сертификат НУЦ Минцифры.";
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ПрочитатьОтветЧата(Результат, Ответ.Тело);
	
КонецПроцедуры

Процедура ВызватьOpenAI(Параметры, СистемныйПромпт, ПользовательскийПромпт, Результат)
	
	Если ПустаяСтрока(Параметры.Адрес) Тогда
		Результат.ТекстОшибки = "Для OpenAI-совместимого подключения укажите адрес API, например https://host/v1/chat/completions.";
		Возврат;
	КонецЕсли;
	
	Результат.Модель = Параметры.Модель;
	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("role, content", "system", СистемныйПромпт));
	Сообщения.Добавить(Новый Структура("role, content", "user", ПользовательскийПромпт));
	Тело = Новый Структура;
	Тело.Вставить("model", Параметры.Модель);
	Тело.Вставить("temperature", Параметры.Температура);
	Тело.Вставить("max_tokens", Параметры.МаксимумТокенов);
	Тело.Вставить("stream", Ложь);
	Тело.Вставить("messages", Сообщения);
	
	Части = РазобратьАдрес(Параметры.Адрес, "/v1/chat/completions");
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Authorization", ЗаголовокКлюча(Параметры.Ключ, Параметры.Схема));
	Ответ = ОтправитьЗапрос(Части.Хост, Части.Порт, Части.Путь, Заголовки, ВJSON(Тело), Параметры.Таймаут, Части.Защита);
	ЗаполнитьПоHTTP(Результат, Ответ);
	Если Не Результат.Успех Тогда
		Возврат;
	КонецЕсли;
	ПрочитатьОтветЧата(Результат, Ответ.Тело);
	
КонецПроцедуры

Процедура ПрочитатьОтветЧата(Результат, Тело)
	
	Данные = ПрочитатьОбъектJSON(Тело);
	Если ТипЗнч(Данные) <> Тип("Структура") Или Не Данные.Свойство("choices")
		Или ТипЗнч(Данные.choices) <> Тип("Массив") Или Данные.choices.Количество() = 0 Тогда
		Результат.Успех = Ложь;
		Результат.ТекстОшибки = "Сервис вернул ответ без текста модели.";
		Возврат;
	КонецЕсли;
	Выбор = Данные.choices[0];
	Если ТипЗнч(Выбор) = Тип("Структура") И Выбор.Свойство("message") И Выбор.message.Свойство("content") Тогда
		Результат.Текст = Строка(Выбор.message.content);
	Иначе
		Результат.Успех = Ложь;
		Результат.ТекстОшибки = "Сервис вернул ответ без поля content.";
		Возврат;
	КонецЕсли;
	Если Выбор.Свойство("finish_reason") И НРег(Строка(Выбор.finish_reason)) = "length" Тогда
		Результат.Обрезан = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция ТокенGigaChat(Параметры, Результат)
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить("Authorization", ЗаголовокКлюча(Параметры.Ключ, "Basic"));
	Заголовки.Вставить("RqUID", Строка(Новый УникальныйИдентификатор));
	Части = РазобратьАдрес(Параметры.АдресАвторизации, "/api/v2/oauth");
	Ответ = ОтправитьЗапрос(
		Части.Хост, Части.Порт, Части.Путь,
		Заголовки, "scope=" + Параметры.ОбластьGigaChat, Параметры.Таймаут, Части.Защита);
	Если Не Ответ.Успех Тогда
		Результат.КодСостояния = Ответ.Код;
		Результат.СыройОтвет = Ответ.Тело;
		Результат.ТекстОшибки = "Не удалось получить токен GigaChat. " + Ответ.Ошибка
			+ " Проверьте ключ авторизации и сертификат НУЦ Минцифры.";
		Возврат "";
	КонецЕсли;
	Данные = ПрочитатьОбъектJSON(Ответ.Тело);
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("access_token") Тогда
		Возврат Строка(Данные.access_token);
	КонецЕсли;
	Результат.ТекстОшибки = "Ответ OAuth GigaChat не содержит access_token.";
	Результат.СыройОтвет = Ответ.Тело;
	Возврат "";
	
КонецФункции

Функция ЗаголовокКлюча(Ключ, Схема)
	
	СхемаНорм = ОчиститьЗначениеЗаголовка(Схема);
	Если ПустаяСтрока(СхемаНорм) Тогда
		СхемаНорм = "Bearer";
	КонецЕсли;
	КлючНорм = ОчиститьЗначениеЗаголовка(Ключ);
	Если СтрНачинаетсяС(НРег(КлючНорм), НРег(СхемаНорм) + " ") Тогда
		Возврат КлючНорм;
	КонецЕсли;
	Возврат СхемаНорм + " " + КлючНорм;
	
КонецФункции

// Убирает переводы строк и табуляции: они ломают HTTP-заголовок и сервис отвечает отказом без тела.
Функция ОчиститьЗначениеЗаголовка(Значение)
	
	Результат = Строка(Значение);
	Результат = СтрЗаменить(Результат, Символы.ПС, "");
	Результат = СтрЗаменить(Результат, Символы.ВК, "");
	Результат = СтрЗаменить(Результат, Символы.Таб, "");
	Возврат СокрЛП(Результат);
	
КонецФункции

Функция РазобратьАдрес(Адрес, ПутьПоУмолчанию)
	
	Части = Новый Структура("Хост, Порт, Путь, Защита", "", 443, ПутьПоУмолчанию, Истина);
	Остаток = СокрЛП(Адрес);
	Если СтрНачинаетсяС(НРег(Остаток), "https://") Тогда
		Остаток = Сред(Остаток, 9);
	ИначеЕсли СтрНачинаетсяС(НРег(Остаток), "http://") Тогда
		Остаток = Сред(Остаток, 8);
		Части.Защита = Ложь;
		Части.Порт = 80;
	КонецЕсли;
	ПозицияСлеша = СтрНайти(Остаток, "/");
	Если ПозицияСлеша = 0 Тогда
		ХостПорт = Остаток;
		Части.Путь = ПутьПоУмолчанию;
	Иначе
		ХостПорт = Лев(Остаток, ПозицияСлеша - 1);
		Части.Путь = Сред(Остаток, ПозицияСлеша);
	КонецЕсли;
	НизкийПуть = НРег(Части.Путь);
	Если НизкийПуть = "/v1" Или НизкийПуть = "/v1/" Тогда
		Части.Путь = "/v1/chat/completions";
	КонецЕсли;
	ПозицияПорта = СтрНайти(ХостПорт, ":");
	Если ПозицияПорта > 0 Тогда
		Части.Хост = Лев(ХостПорт, ПозицияПорта - 1);
		Части.Порт = Число(Сред(ХостПорт, ПозицияПорта + 1));
	Иначе
		Части.Хост = ХостПорт;
	КонецЕсли;
	Возврат Части;
	
КонецФункции

Функция ОтправитьЗапрос(Хост, Порт, Путь, Заголовки, Тело, Таймаут, Защита)
	
	ОтветВызова = Новый Структура("Успех, Код, Тело, Ошибка, Адрес, Отправлено", Ложь, 0, "", "", "", 0);
	ТелоСтрокой = ?(Тело = Неопределено, "", Строка(Тело));
	ОтветВызова.Адрес = ?(Защита, "https://", "http://") + Хост
		+ ?(Порт = 443 Или Порт = 80, "", ":" + Формат(Порт, "ЧГ=0")) + Путь;
	ОтветВызова.Отправлено = СтрДлина(ТелоСтрокой);
	Если ПустаяСтрока(ТелоСтрокой) Тогда
		ОтветВызова.Ошибка = "Тело запроса пустое, отправка отменена. Адрес: " + ОтветВызова.Адрес + ".";
		Возврат ОтветВызова;
	КонецЕсли;
	
	Попытка
		Защищенное = Неопределено;
		Если Защита Тогда
			Защищенное = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Новый СертификатыУдостоверяющихЦентровОС);
		КонецЕсли;
		Соединение = Новый HTTPСоединение(Хост, Порт, , , , Таймаут, Защищенное);
		Запрос = Новый HTTPЗапрос(Путь);
		Для Каждого Заголовок Из Заголовки Цикл
			Запрос.Заголовки.Вставить(Заголовок.Ключ, ОчиститьЗначениеЗаголовка(Заголовок.Значение));
		КонецЦикла;
		Запрос.УстановитьТелоИзСтроки(ТелоСтрокой, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
		ОтветВызова.Код = Ответ.КодСостояния;
		ОтветВызова.Тело = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ОтветВызова.Успех = Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300;
		Если Не ОтветВызова.Успех Тогда
			ОтветВызова.Ошибка = "HTTP " + Формат(Ответ.КодСостояния, "ЧГ=0") + ". "
				+ ?(ПустаяСтрока(ОтветВызова.Тело), ЗаголовкиОтвета(Ответ), Лев(ОтветВызова.Тело, 1500));
		КонецЕсли;
	Исключение
		Информация = ИнформацияОбОшибке();
		ОтветВызова.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(Информация)
			+ " Адрес: " + ОтветВызова.Адрес + ".";
		ОтветВызова.Тело = ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация);
	КонецПопытки;
	Возврат ОтветВызова;
	
КонецФункции

Функция ЗаголовкиОтвета(Ответ)
	
	Результат = "";
	Для Каждого Заголовок Из Ответ.Заголовки Цикл
		Имя = НРег(Заголовок.Ключ);
		Если Имя = "www-authenticate" Или Имя = "server" Или Имя = "x-request-id" Или Имя = "x-sber-id" Тогда
			Результат = Результат + Заголовок.Ключ + ": " + Заголовок.Значение + "; ";
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(Результат) Тогда
		Возврат "Тело ответа пустое. Запрос, вероятно, отклонён прокси или шлюзом до сервиса модели.";
	КонецЕсли;
	Возврат "Тело ответа пустое. Заголовки ответа: " + Лев(Результат, 500);
	
КонецФункции

Процедура ЗаполнитьПоHTTP(Результат, Ответ)
	
	Результат.КодСостояния = Ответ.Код;
	Результат.СыройОтвет = Ответ.Тело;
	Результат.Успех = Ответ.Успех;
	Если Не Ответ.Успех Тогда
		Результат.ТекстОшибки = ТекстОшибкиHTTP(Ответ)
			+ " Адрес: " + Ответ.Адрес + "; отправлено символов: " + Формат(Ответ.Отправлено, "ЧГ=0") + ".";
	КонецЕсли;
	
КонецПроцедуры

Функция ТекстОшибкиHTTP(Ответ)
	
	Если Ответ.Код = 401 Или Ответ.Код = 403 Тогда
		Возврат "Сервис отклонил ключ API (HTTP " + Формат(Ответ.Код, "ЧГ=0") + "). "
			+ "Проверьте ключ, схему авторизации и идентификатор каталога. " + Лев(Ответ.Тело, 500);
	ИначеЕсли Ответ.Код = 429 Тогда
		Возврат "Превышена квота или лимит запросов к модели. Повторите позже.";
	ИначеЕсли Ответ.Код = 0 Тогда
		Возврат "Нет соединения с сервисом модели. " + Ответ.Ошибка;
	КонецЕсли;
	Возврат Ответ.Ошибка;
	
КонецФункции

Процедура ЗавершитьВызов(Результат, Старт, СистемныйПромпт, ПользовательскийПромпт, Контекст)
	
	Результат.ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Старт;
	Промпт = "SYSTEM:" + Символы.ПС + СистемныйПромпт + Символы.ПС + Символы.ПС + "USER:" + Символы.ПС + ПользовательскийПромпт;
	Попытка
		Запись = РегистрыСведений.ЖурналВызововИИ.СоздатьМенеджерЗаписи();
		Запись.Идентификатор = Строка(Новый УникальныйИдентификатор);
		Запись.Успех = Результат.Успех;
		Запись.КодСостояния = Результат.КодСостояния;
		Запись.ДлительностьМс = Результат.ДлительностьМс;
		Запись.Дата = ТекущаяДатаСеанса();
		Запись.Модель = Лев(Строка(Результат.Модель), 150);
		Запись.Промпт = Лев(Промпт, 150000);
		Запись.Ответ = Лев(?(ПустаяСтрока(Результат.Текст), Результат.СыройОтвет, Результат.Текст), 150000);
		Запись.ТекстОшибки = Лев(Результат.ТекстОшибки, 10000);
		Если Контекст.Свойство("Обращение") И ЗначениеЗаполнено(Контекст.Обращение) Тогда
			Запись.Обращение = Контекст.Обращение;
		КонецЕсли;
		Если Контекст.Свойство("Назначение") И ЗначениеЗаполнено(Контекст.Назначение) Тогда
			Запись.Назначение = Контекст.Назначение;
		КонецЕсли;
		Если Контекст.Свойство("Профиль") И ЗначениеЗаполнено(Контекст.Профиль) Тогда
			Запись.Профиль = Контекст.Профиль;
		КонецЕсли;
		Запись.Записать();
	Исключение
		// Журнал не должен скрывать ответ модели.
	КонецПопытки;
	
КонецПроцедуры
