	Если ЗначениеЗаполнено(Справочники.ИОО_ПоляНастроекИнтеграции.НайтиПоНаименованию(Имя, Истина)) Тогда
		Возврат;
	КонецЕсли;
	Поле = Справочники.ИОО_ПоляНастроекИнтеграции.СоздатьЭлемент();
	Поле.Наименование = Имя;
	Поле.Ключ = Ключ;
	Поле.Назначение = Назначение;
	Поле.ТипЗначения = ТипЗначения;
