Процедура ПринятьДемо(Идентификатор, Канал, Контрагент, Адрес, Тема, Текст)
	
	Если ЗначениеЗаполнено(НайтиОбращение(Идентификатор)) Тогда
		Возврат;
	КонецЕсли;
	Данные = Новый Структура;
	Данные.Вставить("Канал", Канал);
	Данные.Вставить("Контрагент", Контрагент);
	Данные.Вставить("УдалитьАдресОтвета", Адрес);
	Данные.Вставить("Тема", Тема);
	Данные.Вставить("Текст", Текст);
	Данные.Вставить("УдалитьВнешнийИдентификатор", Идентификатор);
	Результат = ОбработкаОбращений.ПринятьВходящее(Данные);
	Если Результат.Успех И ЗначениеЗаполнено(Результат.Ссылка) Тогда
		Документ = Результат.Ссылка.ПолучитьОбъект();
		Документ.Метка = "ДЕМО";
		Документ.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиОбращение(Идентификатор)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Обращение.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ИОО_Обращение КАК Обращение
	|ГДЕ
	|	Обращение.УдалитьВнешнийИдентификатор = &Идентификатор
	|	И НЕ Обращение.ПометкаУдаления";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Документы.ИОО_Обращение.ПустаяСсылка();
	
КонецФункции

Функция НайтиИсправление(Идентификатор)
	
	Обращение = НайтиОбращение(Идентификатор);
	Если Не ЗначениеЗаполнено(Обращение) Тогда
		Возврат "";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Исправления.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ИсправленияКлассификации КАК Исправления
	|ГДЕ
	|	Исправления.Обращение = &Обращение";
	Запрос.УстановитьПараметр("Обращение", Обращение);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Идентификатор;
	КонецЕсли;
	Возврат "";
	
КонецФункции
