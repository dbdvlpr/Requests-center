// Демонстрационный контур ТехноСервис: клиенты, договоры, восемь инженеров и десять обращений.
// Классификацию выполняет живая модель по кнопке оператора, а не зашитые правила.

Процедура Заполнить() Экспорт
	
	ОбеспечитьНастройкиПоУмолчанию();
	ОбеспечитьПоляЗапросаLLM();
	ОбеспечитьНастройкиПрофиля(Константы.АктивныйПрофильLLM.Получить());
	ОбеспечитьПользователей();
	Теги = ОбеспечитьТеги();
	Категории = ОбеспечитьКатегории(Теги);
	Сотрудники = ОбеспечитьСотрудников(Теги);
	Клиенты = ОбеспечитьКлиентов();
	ОбеспечитьНоменклатуру();
	ОбеспечитьНагрузку(Категории.Получить("Неисправность оборудования"), Сотрудники.Получить("Смирнов Алексей Игоревич"));
	ОбеспечитьИсторию(Категории, Сотрудники, Клиенты);
	ОбеспечитьВходящие(Клиенты);
	
КонецПроцедуры

Процедура ОбеспечитьНастройкиПоУмолчанию() Экспорт
	
	ОбеспечитьБазовыеСправочники();
	
	Если ЗначениеЗаполнено(Константы.АктивныйПрофильLLM.Получить()) Тогда
		Возврат;
	КонецЕсли;
	
	Профиль = Справочники.ИОО_ПрофилиLLM.НайтиПоНаименованию("YandexGPT — основная модель", Истина);
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		Элемент = Справочники.ИОО_ПрофилиLLM.СоздатьЭлемент();
		Элемент.Наименование = "YandexGPT — основная модель";
		Элемент.Провайдер = Справочники.ИОО_ПровайдерыLLM.YandexGPT;
		Элемент.Модель = "yandexgpt/latest";
		Элемент.ТаймаутСекунд = 90;
		Элемент.МаксимумТокенов = 2000;
		Элемент.Температура = 0.1;
		Элемент.КоличествоПримеров = 4;
		Элемент.РежимОбезличивания = Перечисления.ИОО_РежимыОбезличивания.Токенизация;
		Элемент.ВосстанавливатьТокены = Истина;
		Элемент.ХранитьПромптВЖурнале = Истина;
		Элемент.ПрофильПоУмолчанию = Истина;
		Элемент.Записать();
		Профиль = Элемент.Ссылка;
	КонецЕсли;
	Константы.АктивныйПрофильLLM.Установить(Профиль);
	
КонецПроцедуры

Процедура ОбеспечитьБазовыеСправочники()
	
	ЗаполнитьУровеньЭмоциональности(Справочники.ИОО_УровниЭмоциональности.Нейтральный, 0, Ложь);
	ЗаполнитьУровеньЭмоциональности(Справочники.ИОО_УровниЭмоциональности.Недовольный, 1, Истина);
	ЗаполнитьУровеньЭмоциональности(Справочники.ИОО_УровниЭмоциональности.Раздраженный, 2, Истина);
	
	ЗаполнитьПриоритетКонтрагента(Справочники.ИОО_ПриоритетыКонтрагентов.Обычный, 1);
	ЗаполнитьПриоритетКонтрагента(Справочники.ИОО_ПриоритетыКонтрагентов.Приоритетный, 2);
	ЗаполнитьПриоритетКонтрагента(Справочники.ИОО_ПриоритетыКонтрагентов.VIP, 3);
	
	ЗаполнитьСтатус(Справочники.ИОО_СтатусыОбращений.Новое, 1, Ложь, Ложь);
	ЗаполнитьСтатус(Справочники.ИОО_СтатусыОбращений.Классифицировано, 2, Ложь, Ложь);
	ЗаполнитьСтатус(Справочники.ИОО_СтатусыОбращений.Назначено, 3, Ложь, Ложь);
	ЗаполнитьСтатус(Справочники.ИОО_СтатусыОбращений.ОтветПодготовлен, 4, Ложь, Ложь);
	ЗаполнитьСтатус(Справочники.ИОО_СтатусыОбращений.ОтветОтправлен, 5, Истина, Ложь);
	ЗаполнитьСтатус(Справочники.ИОО_СтатусыОбращений.Закрыто, 6, Истина, Ложь);
	ЗаполнитьСтатус(Справочники.ИОО_СтатусыОбращений.ОшибкаИИ, 0, Ложь, Истина);
	
	ЗаполнитьКанал(Справочники.ИОО_КаналыОбращений.Почта, "email", Справочники.ИОО_СпособыОтвета.ЭлектроннаяПочта);
	ЗаполнитьКанал(Справочники.ИОО_КаналыОбращений.Звонок, "phone", Справочники.ИОО_СпособыОтвета.СообщеноПоЗвонку);
	ЗаполнитьКанал(Справочники.ИОО_КаналыОбращений.ВебФорма, "web", Справочники.ИОО_СпособыОтвета.ПубликацияВФорме);
	
	ЗаполнитьПровайдера(Справочники.ИОО_ПровайдерыLLM.YandexGPT, "Yandex",
		"https://llm.api.cloud.yandex.net/foundationModels/v1/completion", "", "Api-Key", "");
	ЗаполнитьПровайдера(Справочники.ИОО_ПровайдерыLLM.GigaChat, "GigaChat",
		"https://gigachat.devices.sberbank.ru/api/v1/chat/completions",
		"https://ngw.devices.sberbank.ru:9443/api/v2/oauth", "Bearer", "GIGACHAT_API_PERS");
	ЗаполнитьПровайдера(Справочники.ИОО_ПровайдерыLLM.OpenAIСовместимый, "OpenAI", "", "", "Bearer", "");

	ОбеспечитьПравилаОбезличивания();
	ОбеспечитьПоляНастроекИнтеграции();

КонецПроцедуры

// Заводит правила обезличивания по умолчанию. Существующие правила не трогает.
Процедура ОбеспечитьПравилаОбезличивания()

	ОбеспечитьПравилоОбезличивания("Почта", Перечисления.ИОО_ТипыДанныхПДн.Почта,
		"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}", "<ПОЧТА>", 10, Истина, Ложь);
	ОбеспечитьПравилоОбезличивания("Телефон", Перечисления.ИОО_ТипыДанныхПДн.Телефон,
		"([+]7|8)[ .-]?[(]?[0-9]{3}[)]?[ .-]?[0-9]{3}[ .-]?[0-9]{2}[ .-]?[0-9]{2}", "<ТЕЛЕФОН>", 20, Истина, Ложь);
	ОбеспечитьПравилоОбезличивания("СНИЛС", Перечисления.ИОО_ТипыДанныхПДн.СНИЛС,
		"[0-9]{3}-[0-9]{3}-[0-9]{3} [0-9]{2}", "<СНИЛС>", 30, Истина, Ложь);
	ОбеспечитьПравилоОбезличивания("Банковская карта", Перечисления.ИОО_ТипыДанныхПДн.БанковскаяКарта,
		"[0-9]{4} [0-9]{4} [0-9]{4} [0-9]{4}", "<КАРТА>", 40, Истина, Ложь);
	ОбеспечитьПравилоОбезличивания("ИНН из 12 цифр", Перечисления.ИОО_ТипыДанныхПДн.ИНН,
		"[0-9]{12}", "<ИНН>", 50, Истина, Ложь);
	ОбеспечитьПравилоОбезличивания("ИНН из 10 цифр", Перечисления.ИОО_ТипыДанныхПДн.ИНН,
		"[0-9]{10}", "<ИНН>", 60, Истина, Ложь);
	ОбеспечитьПравилоОбезличивания("Номер договора", Перечисления.ИОО_ТипыДанныхПДн.НомерДоговора,
		"(договор|дог[.]|контракт)[ ]*(№|N)?[ ]*[A-Za-zА-Яа-я0-9/-]{3,20}", "<ДОГОВОР>", 70, Истина, Истина);
	ОбеспечитьПравилоОбезличивания("ФИО", Перечисления.ИОО_ТипыДанныхПДн.ФИО,
		"[А-ЯЁ][а-яё]+ [А-ЯЁ][а-яё]+ [А-ЯЁ][а-яё]+", "<ФИО>", 80, Истина, Истина);
	ОбеспечитьПравилоОбезличивания("Адрес", Перечисления.ИОО_ТипыДанныхПДн.Адрес,
		"(ул[.]|улица|г[.]|город|пер[.]|проспект|пр-т)[ ]*[А-Яа-яЁё0-9 .-]{3,60}", "<АДРЕС>", 90, Ложь, Истина);

КонецПроцедуры

Процедура ОбеспечитьПравилоОбезличивания(Имя, ТипДанных, Образец, Замена, Порядок, Активно, ТолькоСтрогий)

	Если ЗначениеЗаполнено(Справочники.ИОО_ПравилаОбезличивания.НайтиПоНаименованию(Имя, Истина)) Тогда
		Возврат;
	КонецЕсли;
	Правило = Справочники.ИОО_ПравилаОбезличивания.СоздатьЭлемент();
	Правило.Наименование = Имя;
	Правило.ТипДанных = ТипДанных;
	Правило.Образец = Образец;
	Правило.Замена = Замена;
	Правило.Порядок = Порядок;
	Правило.Активно = Активно;
	Правило.ТолькоСтрогийРежим = ТолькоСтрогий;
	Правило.Записать();

КонецПроцедуры

