// Наполняет пустые настройки профиля значениями реестра: поля по умолчанию и все функции.
Процедура ОбеспечитьНастройкиПрофиля(Профиль)

	Если Не ЗначениеЗаполнено(Профиль) Тогда
		Возврат;
	КонецЕсли;
	Объект = Профиль.ПолучитьОбъект();
	Изменен = Ложь;

	Если Объект.ДоступныеПоля.Количество() = 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Поля.Ссылка КАК Поле,
		|	Поля.Обезличивать КАК Обезличивать,
		|	Поля.Порядок КАК Порядок
		|ИЗ
		|	Справочник.ИОО_ПоляЗапросаLLM КАК Поля
		|ГДЕ
		|	Поля.Активно
		|	И НЕ Поля.ПометкаУдаления
		|	И (Поля.ПоУмолчанию ИЛИ Поля.Обязательное)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Поля.Порядок";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Строка = Объект.ДоступныеПоля.Добавить();
			Строка.Поле = Выборка.Поле;
			Строка.Обезличивать = Выборка.Обезличивать;
			Строка.Порядок = Выборка.Порядок;
		КонецЦикла;
		Изменен = Истина;
	КонецЕсли;

	Если Объект.Функции.Количество() = 0 Тогда
		Для Каждого Значение Из Перечисления.ИОО_ФункцииПрофиля Цикл
			Строка = Объект.Функции.Добавить();
			Строка.Функция = Значение;
		КонецЦикла;
		Изменен = Истина;
	КонецЕсли;

	Если Изменен Тогда
		Объект.Записать();
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьУровеньЭмоциональности(Ссылка, Вес, Негативный)
	
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект.Вес = Вес И Объект.Негативный = Негативный Тогда
		Возврат;
	КонецЕсли;
	Объект.Вес = Вес;
	Объект.Негативный = Негативный;
	Объект.Записать();
	
КонецПроцедуры

Процедура ЗаполнитьПриоритетКонтрагента(Ссылка, Ранг)
	
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект.Ранг = Ранг Тогда
		Возврат;
	КонецЕсли;
	Объект.Ранг = Ранг;
	Объект.Записать();
	
КонецПроцедуры

Процедура ЗаполнитьСтатус(Ссылка, Порядок, Закрывающий, ОшибкаОбработки)
	
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект.Порядок = Порядок
		И Объект.Закрывающий = Закрывающий
		И Объект.ОшибкаОбработки = ОшибкаОбработки Тогда
		Возврат;
	КонецЕсли;
	Объект.Порядок = Порядок;
	Объект.Закрывающий = Закрывающий;
	Объект.ОшибкаОбработки = ОшибкаОбработки;
	Объект.Записать();
	
КонецПроцедуры

Процедура ЗаполнитьКанал(Ссылка, ВнешнийКод, СпособОтвета)
	
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект.ВнешнийКод = ВнешнийКод
		И Объект.СпособОтветаПоУмолчанию = СпособОтвета
		И Объект.Активен Тогда
		Возврат;
	КонецЕсли;
	Объект.ВнешнийКод = ВнешнийКод;
	Объект.СпособОтветаПоУмолчанию = СпособОтвета;
	Объект.Активен = Истина;
	Объект.Записать();
	
КонецПроцедуры

Процедура ЗаполнитьПровайдера(Ссылка, ФорматПротокола, АдресAPI, АдресАвторизации, СхемаАвторизации, ОбластьДоступа)
	
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект.ФорматПротокола = ФорматПротокола
		И Объект.АдресAPI = АдресAPI
		И Объект.АдресАвторизации = АдресАвторизации
		И Объект.СхемаАвторизации = СхемаАвторизации
		И Объект.ОбластьДоступа = ОбластьДоступа
		И Объект.Активен Тогда
		Возврат;
	КонецЕсли;
	Объект.ФорматПротокола = ФорматПротокола;
	Объект.АдресAPI = АдресAPI;
	Объект.АдресАвторизации = АдресАвторизации;
	Объект.СхемаАвторизации = СхемаАвторизации;
	Объект.ОбластьДоступа = ОбластьДоступа;
	Объект.Активен = Истина;
	Объект.Записать();
	
КонецПроцедуры

