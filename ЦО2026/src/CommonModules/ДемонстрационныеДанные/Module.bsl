Процедура ОбеспечитьДоговор(Контрагент, Номер, ИмяУровня)
	
	Если ЗначениеЗаполнено(Справочники.Договоры.НайтиПоНаименованию(Номер, Истина)) Тогда
		Возврат;
	КонецЕсли;
	Уровень = Справочники.ИОО_ПриоритетыКонтрагентов.Обычный;
	Если ИмяУровня = "VIP" Тогда
		Уровень = Справочники.ИОО_ПриоритетыКонтрагентов.VIP;
	ИначеЕсли ИмяУровня = "Приоритетный" Тогда
		Уровень = Справочники.ИОО_ПриоритетыКонтрагентов.Приоритетный;
	КонецЕсли;
	Договор = Справочники.Договоры.СоздатьЭлемент();
	Договор.Наименование = Номер;
	Договор.Контрагент = Контрагент;
	Договор.НомерДоговора = Номер;
	Договор.ДатаНачала = НачалоДня(ТекущаяДатаСеанса()) - 120 * 86400;
	Договор.ПриоритетКонтрагента = Уровень;
	Договор.Действует = Истина;
	Договор.Записать();
	
КонецПроцедуры

