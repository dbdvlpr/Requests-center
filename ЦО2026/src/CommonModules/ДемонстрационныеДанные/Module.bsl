Процедура СоздатьЗакрытое(Идентификатор, Контрагент, Категория, Исполнитель, Верификация, Текст, Минут, ДнейНазад)
	
	Если ЗначениеЗаполнено(НайтиОбращение(Идентификатор)) Тогда
		Возврат;
	КонецЕсли;
	Поступление = ТекущаяДатаСеанса() - ДнейНазад * 86400;
	Документ = Документы.ИОО_Обращение.СоздатьДокумент();
	Документ.Дата = Поступление;
	Документ.ДатаПоступления = Поступление;
	Документ.ДатаКлассификации = Поступление + 300;
	Документ.ДатаНазначения = Документ.ДатаКлассификации;
	Документ.ДатаОтвета = Поступление + Минут * 60;
	Документ.Канал = Справочники.ИОО_КаналыОбращений.Почта;
	Документ.Контрагент = Контрагент;
	Договорные = ОбработкаОбращений.АктивныйДоговор(Контрагент);
	Документ.Договор = Договорные.Договор;
	Документ.УровеньКонтрагента = Договорные.Уровень;
	Документ.Тема = "Закрытый пример для панели";
	Документ.Текст = Текст;
	Документ.Категория = Категория;
	Документ.УдалитьКатегорияИИ = Категория;
	Документ.УровеньЭмоциональности = Справочники.ИОО_УровниЭмоциональности.Нейтральный;
	Документ.ОценкаПриоритета = 2;
	Документ.Приоритет = 2;
	Документ.УдалитьПриоритетИИ = 2;
	Документ.Исполнитель = Исполнитель;
	Документ.УдалитьИсполнительИИ = Исполнитель;
	Документ.Статус = Справочники.ИОО_СтатусыОбращений.ОтветОтправлен;
	Документ.СтатусВерификации = Верификация;
	Документ.ТекстОтвета = "Ответ передан клиенту.";
	Документ.СпособОтвета = Справочники.ИОО_СпособыОтвета.ЭлектроннаяПочта;
	Документ.УдалитьВнешнийИдентификатор = Идентификатор;
	Документ.Метка = "ИСТОРИЯ";
	Документ.Комментарий = "Закрыто до показа живой модели, чтобы на панели были время и точность.";
	Документ.Записать();
	
КонецПроцедуры

