			Продолжить;
		КонецЕсли;
		Элемент = Справочники.Номенклатура.СоздатьЭлемент();
		Элемент.Наименование = Позиция.Имя;
		Элемент.Артикул = Позиция.Артикул;
		Элемент.Описание = Позиция.Описание;
		Элемент.Остаток = Позиция.Остаток;
		Элемент.Цена = Позиция.Цена;
		Элемент.КлючевыеСлова = Позиция.Слова;
		Элемент.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбеспечитьНагрузку(Категория, Исполнитель)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Обращения.УдалитьВнешнийИдентификатор КАК УдалитьВнешнийИдентификатор
		|ИЗ
		|	Документ.ИОО_Обращение КАК Обращения
		|ГДЕ
		|	Обращения.УдалитьВнешнийИдентификатор ПОДОБНО ""НАГРУЗКА-%""";
	Существующие = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Существующие.Вставить(Выборка.ВнешнийИдентификатор, Истина);
	КонецЦикла;
	
	Для Номер = 1 По 4 Цикл
		Идентификатор = "НАГРУЗКА-" + Формат(Номер, "ЧГ=0");
		Если Существующие.Получить(Идентификатор) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Документ = Документы.ИОО_Обращение.СоздатьДокумент();
		Документ.Дата = ТекущаяДатаСеанса() - 86400;
		Документ.ДатаПоступления = Документ.Дата;
		Документ.Канал = Справочники.ИОО_КаналыОбращений.Почта;
		Документ.Тема = "Текущий ремонт в работе";
		Документ.Текст = "Плановый ремонт оборудования, заявка уже у инженера.";
		Документ.Категория = Категория;
		Документ.Исполнитель = Исполнитель;
		Документ.УдалитьИсполнительИИ = Исполнитель;
		Документ.Приоритет = 2;
		Документ.УдалитьПриоритетИИ = 2;
		Документ.ОценкаПриоритета = 2;
		Документ.УровеньЭмоциональности = Справочники.ИОО_УровниЭмоциональности.Нейтральный;
		Документ.Статус = Справочники.ИОО_СтатусыОбращений.Назначено;
		Документ.СтатусВерификации = Справочники.ИОО_СтатусыВерификации.Подтверждено;
		Документ.УдалитьВнешнийИдентификатор = Идентификатор;
		Документ.Метка = "НАГРУЗКА";
		Документ.Комментарий = "Открытая заявка для демонстрации загрузки Смирнова.";
		Документ.Записать();
	КонецЦикла;
	
КонецПроцедуры

