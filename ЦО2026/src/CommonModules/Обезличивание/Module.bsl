// Обезличивание данных перед отправкой в модель и восстановление токенов в ответе.
//
// Режимы задаются профилем LLM:
//   Выключено    - текст уходит как есть (используется только для отладки);
//   Маскировка   - значения заменяются на <СКРЫТО> без возможности восстановления;
//   Токенизация  - значения заменяются на <КЛИЕНТ_1>, <ТЕЛЕФОН_1> и т.п., карта пишется
//                  в регистр ИОО_КартаТокенов, ответ модели можно восстановить.

// Обезличивает текст по режиму профиля.
//
// Параметры:
//   Текст - Строка - исходный текст.
//   Обращение - ДокументСсылка.ИОО_Обращение - обращение, из карточки которого берутся значения.
//   Режим - ПеречислениеСсылка.ИОО_РежимыОбезличивания, Неопределено - режим обезличивания;
//           Неопределено - режим активного профиля LLM.
//   ДополнительныеЗначения - Массив из Структура, Неопределено - элементы Структура("Значение, ТипДанных")
//           для замены помимо карточки обращения.
//
// Возвращаемое значение:
//   Структура - результат обезличивания:
//     * Текст - Строка - обезличенный текст;
//     * Замен - Число - сколько замен выполнено;
//     * Утечек - Число - сколько подозрительных фрагментов найдено после замен;
//     * НайденыТипы - Массив из ПеречислениеСсылка.ИОО_ТипыДанныхПДн - типы данных,
//           найденные при контроле утечек;
//     * Режим - ПеречислениеСсылка.ИОО_РежимыОбезличивания, Неопределено - применённый режим.
//
Функция Обезличить(Текст, Обращение, Режим = Неопределено, ДополнительныеЗначения = Неопределено) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Текст", Строка(Текст));
	Результат.Вставить("Замен", 0);
	Результат.Вставить("Утечек", 0);
	Результат.Вставить("НайденыТипы", Новый Массив);

	Если Режим = Неопределено Тогда
		Режим = РежимПоУмолчанию();
	КонецЕсли;
	Результат.Вставить("Режим", Режим);

	Если Режим = Перечисления.ИОО_РежимыОбезличивания.Выключено
		Или ПустаяСтрока(СтрЗаменить(Результат.Текст, Символы.ПС, "")) Тогда
		Возврат Результат;
	КонецЕсли;

	Токенизация = (Режим = Перечисления.ИОО_РежимыОбезличивания.Токенизация);
	Если Токенизация И ЗначениеЗаполнено(Обращение) Тогда
		ОчиститьКарту(Обращение);
	КонецЕсли;

	Значения = СловарьЗначений(Обращение, ДополнительныеЗначения);
	Карта = Новый Соответствие;
	Счетчики = Новый Соответствие;
	Пока Значения.Количество() > 0 Цикл
		ИндексМаксимума = 0;
		Для Индекс = 1 По Значения.Количество() - 1 Цикл
			Если СтрДлина(Значения[Индекс].Значение) > СтрДлина(Значения[ИндексМаксимума].Значение) Тогда
				ИндексМаксимума = Индекс;
			КонецЕсли;
		КонецЦикла;
		Пара = Значения[ИндексМаксимума];
		Значения.Удалить(ИндексМаксимума);

		Если Токенизация Тогда
			Замена = ТокенДля(Пара, Карта, Счетчики);
			ЗаписатьТокен(Обращение, Замена, Пара);
		Иначе
			Замена = "<СКРЫТО>";
		КонецЕсли;
		Результат.Замен = Результат.Замен + ЗаменитьЗначение(Результат, Пара.Значение, Замена);
	КонецЦикла;

	// Правила из справочника: регулярные выражения в порядке Порядок.
	Для Каждого Правило Из АктивныеПравила(Токенизация) Цикл
		Замена = ?(ПустаяСтрока(Правило.Замена), "<СКРЫТО>", Правило.Замена);
		Результат.Замен = Результат.Замен + ЗаменитьПоОбразцу(Результат, Правило.Образец, Замена);
	КонецЦикла;

	Утечки = ПроверитьУтечки(Результат.Текст);
	Результат.Текст = Утечки.Текст;
	Результат.Утечек = Утечки.Количество;
	Результат.НайденыТипы = Утечки.Типы;
	Возврат Результат;

КонецФункции

// Восстанавливает токены в тексте ответа модели.
//
// Параметры:
//   Текст - Строка - текст с токенами.
//   Обращение - ДокументСсылка.ИОО_Обращение - обращение, по которому сохранена карта.
//
// Возвращаемое значение:
//   Строка - текст с реальными значениями; неизвестные токены остаются как есть.
//
Функция Восстановить(Текст, Обращение) Экспорт

	Итог = Строка(Текст);
	Если ПустаяСтрока(Итог) Или Не ЗначениеЗаполнено(Обращение) Тогда
		Возврат Итог;
	КонецЕсли;
	Карта = КартаТокенов(Обращение);
	Если Карта.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;

	Результат = "";
	Остаток = Итог;
	Пока Истина Цикл
		Начало = СтрНайти(Остаток, "<");
		Если Начало = 0 Тогда
			Результат = Результат + Остаток;
			Прервать;
		КонецЕсли;
		Фрагмент = Сред(Остаток, Начало);
		Закрытие = СтрНайти(Фрагмент, ">");
		Если Закрытие = 0 Тогда
			Результат = Результат + Остаток;
			Прервать;
		КонецЕсли;
		Токен = Лев(Фрагмент, Закрытие);
		Значение = Карта.Получить(НормализоватьТокен(Токен));
		Результат = Результат + Лев(Остаток, Начало - 1) + ?(Значение = Неопределено, Токен, Значение);
		Остаток = Сред(Фрагмент, Закрытие + 1);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ищет в тексте признаки персональных данных, не поймавшиеся заменами.
//
// Параметры:
//   Текст - Строка - текст для проверки.
//
// Возвращаемое значение:
//   Структура - результат проверки:
//     * Текст - Строка - текст, в котором найденное заменено на <СКРЫТО>;
//     * Количество - Число - сколько типов данных найдено;
//     * Типы - Массив из ПеречислениеСсылка.ИОО_ТипыДанныхПДн - найденные типы.
//
Функция ПроверитьУтечки(Текст) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Текст", Строка(Текст));
	Результат.Вставить("Количество", 0);
	Результат.Вставить("Типы", Новый Массив);

	Для Каждого Правило Из АктивныеПравила(Истина) Цикл
		Было = Результат.Текст;
		Результат.Текст = СтрЗаменитьПоРегулярномуВыражению(Было, Правило.Образец, "<СКРЫТО>", Истина);
		Если Результат.Текст <> Было Тогда
			Результат.Количество = Результат.Количество + 1;
			ДобавитьТип(Результат.Типы, Правило.ТипДанных);
		КонецЕсли;
	КонецЦикла;

	// Явные признаки, для которых правило может быть выключено.
	Было = Результат.Текст;
	Результат.Текст = СтрЗаменитьПоРегулярномуВыражению(Было, "[^ \t\r\n<>]{1,64}@[^ \t\r\n<>]{1,64}", "<СКРЫТО>", Истина);
	Если Результат.Текст <> Было Тогда
		Результат.Количество = Результат.Количество + 1;
		ДобавитьТип(Результат.Типы, Перечисления.ИОО_ТипыДанныхПДн.Почта);
	КонецЕсли;
	Было = Результат.Текст;
	Результат.Текст = СтрЗаменитьПоРегулярномуВыражению(Было, "([+]7|8)[ .\-]?\(?[0-9]{3}\)?[ .\-]?[0-9]{3}[ .\-]?[0-9]{2}[ .\-]?[0-9]{2}", "<СКРЫТО>", Истина);
	Если Результат.Текст <> Было Тогда
		Результат.Количество = Результат.Количество + 1;
		ДобавитьТип(Результат.Типы, Перечисления.ИОО_ТипыДанныхПДн.Телефон);
	КонецЕсли;
	Было = Результат.Текст;
	Результат.Текст = СтрЗаменитьПоРегулярномуВыражению(Было, "[0-9]{10,15}", "<СКРЫТО>", Истина);
	Если Результат.Текст <> Было Тогда
		Результат.Количество = Результат.Количество + 1;
		ДобавитьТип(Результат.Типы, Перечисления.ИОО_ТипыДанныхПДн.Телефон);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает режим обезличивания активного профиля LLM.
//
// Возвращаемое значение:
//   ПеречислениеСсылка.ИОО_РежимыОбезличивания - режим; по умолчанию Токенизация.
//
Функция РежимПоУмолчанию() Экспорт

	Профиль = ИнтеграцияLLM.АктивныйПрофиль();
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		Возврат Перечисления.ИОО_РежимыОбезличивания.Токенизация;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Профили.РежимОбезличивания КАК Режим
	|ИЗ
	|	Справочник.ИОО_ПрофилиLLM КАК Профили
	|ГДЕ
	|	Профили.Ссылка = &Профиль";
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Режим) Тогда
		Возврат Выборка.Режим;
	КонецЕсли;
	Возврат Перечисления.ИОО_РежимыОбезличивания.Токенизация;

КонецФункции

// Очищает карту токенов обращения.
//
// Параметры:
//   Обращение - ДокументСсылка.ИОО_Обращение - обращение.
//
Процедура ОчиститьКарту(Обращение) Экспорт

	Если Не ЗначениеЗаполнено(Обращение) Тогда
		Возврат;
	КонецЕсли;
	Набор = РегистрыСведений.ИОО_КартаТокенов.СоздатьНаборЗаписей();
	Набор.Отбор.Обращение.Установить(Обращение);
	Набор.Записать();

КонецПроцедуры

// Экранирует спецсимволы регулярного выражения.
//
// Параметры:
//   Значение - Строка - текст для экранирования.
//
// Возвращаемое значение:
//   Строка - безопасный образец.
//
Функция ЭкранироватьРегВыражение(Значение) Экспорт

	Результат = Строка(Значение);
	Результат = СтрЗаменить(Результат, "\", "\\");
	Спецсимволы = ".[]{}()*+-?^$|";
	Для Индекс = 1 По СтрДлина(Спецсимволы) Цикл
		Символ = Сред(Спецсимволы, Индекс, 1);
		Результат = СтрЗаменить(Результат, Символ, "\" + Символ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Собирает значения для замены: карточка обращения плюс переданные извне.
//
// Параметры:
//   Обращение - ДокументСсылка.ИОО_Обращение - обращение.
//   ДополнительныеЗначения - Массив, Неопределено - элементы Структура("Значение, ТипДанных").
//
// Возвращаемое значение:
//   Массив - элементы Структура("Значение, ТипДанных").
//
Функция СловарьЗначений(Обращение, ДополнительныеЗначения)

	Значения = Новый Массив;
	Если ЗначениеЗаполнено(Обращение) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЕСТЬNULL(Обращение.Контрагент.Наименование, """") КАК Контрагент,
		|	ЕСТЬNULL(Обращение.Контрагент.ИНН, """") КАК ИНН,
		|	ЕСТЬNULL(Обращение.Контрагент.Телефон, """") КАК Телефон,
		|	ЕСТЬNULL(Обращение.Контрагент.ЭлектроннаяПочта, """") КАК Почта,
		|	ЕСТЬNULL(Обращение.Договор.НомерДоговора, """") КАК НомерДоговора,
		|	ЕСТЬNULL(Обращение.УдалитьАдресОтвета, """") КАК Адрес
		|ИЗ
		|	Документ.ИОО_Обращение КАК Обращение
		|ГДЕ
		|	Обращение.Ссылка = &Обращение";
		Запрос.УстановитьПараметр("Обращение", Обращение);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ДобавитьЗначение(Значения, Выборка.Контрагент, Перечисления.ИОО_ТипыДанныхПДн.Организация);
			ДобавитьЗначение(Значения, Выборка.ИНН, Перечисления.ИОО_ТипыДанныхПДн.ИНН);
			ДобавитьЗначение(Значения, Выборка.Телефон, Перечисления.ИОО_ТипыДанныхПДн.Телефон);
			ДобавитьЗначение(Значения, Выборка.Почта, Перечисления.ИОО_ТипыДанныхПДн.Почта);
			ДобавитьЗначение(Значения, Выборка.НомерДоговора, Перечисления.ИОО_ТипыДанныхПДн.НомерДоговора);
			ДобавитьЗначение(Значения, Выборка.Адрес, Перечисления.ИОО_ТипыДанныхПДн.Адрес);
		КонецЕсли;
	КонецЕсли;
	Если ДополнительныеЗначения <> Неопределено Тогда
		Для Каждого Пара Из ДополнительныеЗначения Цикл
			ДобавитьЗначение(Значения, Пара.Значение, Пара.ТипДанных);
		КонецЦикла;
	КонецЕсли;
	Возврат Значения;

КонецФункции

Процедура ДобавитьЗначение(Значения, Значение, ТипДанных)

	Текст = СокрЛП(Строка(Значение));
	Если СтрДлина(Текст) < 3 Тогда
		Возврат;
	КонецЕсли;
	Пара = Новый Структура("Значение, ТипДанных");
	Пара.Значение = Текст;
	Пара.ТипДанных = ТипДанных;
	Значения.Добавить(Пара);

КонецПроцедуры

Функция ТокенДля(Пара, Карта, Счетчики)

	Ключ = НРег(Пара.Значение);
	Существующий = Карта.Получить(Ключ);
	Если Существующий <> Неопределено Тогда
		Возврат Существующий;
	КонецЕсли;
	Префикс = ПрефиксТипа(Пара.ТипДанных);
	Номер = Счетчики.Получить(Префикс);
	Если Номер = Неопределено Тогда
		Номер = 0;
	КонецЕсли;
	Номер = Номер + 1;
	Счетчики.Вставить(Префикс, Номер);
	Токен = "<" + Префикс + "_" + Формат(Номер, "ЧГ=0") + ">";
	Карта.Вставить(Ключ, Токен);
	Возврат Токен;

КонецФункции

Функция ПрефиксТипа(ТипДанных)

	Если ТипДанных = Перечисления.ИОО_ТипыДанныхПДн.Организация Тогда
		Возврат "КЛИЕНТ";
	ИначеЕсли ТипДанных = Перечисления.ИОО_ТипыДанныхПДн.Почта Тогда
		Возврат "ПОЧТА";
	ИначеЕсли ТипДанных = Перечисления.ИОО_ТипыДанныхПДн.Телефон Тогда
		Возврат "ТЕЛЕФОН";
	ИначеЕсли ТипДанных = Перечисления.ИОО_ТипыДанныхПДн.Адрес Тогда
		Возврат "АДРЕС";
	ИначеЕсли ТипДанных = Перечисления.ИОО_ТипыДанныхПДн.ИНН Тогда
		Возврат "ИНН";
	ИначеЕсли ТипДанных = Перечисления.ИОО_ТипыДанныхПДн.НомерДоговора Тогда
		Возврат "ДОГОВОР";
	ИначеЕсли ТипДанных = Перечисления.ИОО_ТипыДанныхПДн.НомерСчета Тогда
		Возврат "СЧЕТ";
	ИначеЕсли ТипДанных = Перечисления.ИОО_ТипыДанныхПДн.БанковскаяКарта Тогда
		Возврат "КАРТА";
	ИначеЕсли ТипДанных = Перечисления.ИОО_ТипыДанныхПДн.СНИЛС Тогда
		Возврат "СНИЛС";
	ИначеЕсли ТипДанных = Перечисления.ИОО_ТипыДанныхПДн.Паспорт Тогда
		Возврат "ПАСПОРТ";
	ИначеЕсли ТипДанных = Перечисления.ИОО_ТипыДанныхПДн.Ссылка Тогда
		Возврат "ССЫЛКА";
	ИначеЕсли ТипДанных = Перечисления.ИОО_ТипыДанныхПДн.Логин Тогда
		Возврат "ЛОГИН";
	КонецЕсли;
	Возврат "ДАННЫЕ";

КонецФункции

Процедура ЗаписатьТокен(Обращение, Токен, Пара)

	Если Не ЗначениеЗаполнено(Обращение) Тогда
		Возврат;
	КонецЕсли;
	Запись = РегистрыСведений.ИОО_КартаТокенов.СоздатьМенеджерЗаписи();
	Запись.Обращение = Обращение;
	Запись.Токен = Лев(Токен, 60);
	Запись.Значение = Лев(Пара.Значение, 500);
	Запись.Дата = ТекущаяДатаСеанса();
	Запись.ТипДанных = Пара.ТипДанных;
	Запись.Записать();

КонецПроцедуры

Функция КартаТокенов(Обращение)

	Карта = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Карта.Токен КАК Токен,
	|	Карта.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ИОО_КартаТокенов КАК Карта
	|ГДЕ
	|	Карта.Обращение = &Обращение";
	Запрос.УстановитьПараметр("Обращение", Обращение);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Карта.Вставить(НормализоватьТокен(Выборка.Токен), Выборка.Значение);
	КонецЦикла;
	Возврат Карта;

КонецФункции

Функция НормализоватьТокен(Токен)

	Результат = ВРег(Строка(Токен));
	Результат = СтрЗаменить(Результат, " ", "");
	Результат = СтрЗаменить(Результат, "_", "");
	Возврат Результат;

КонецФункции

// Возвращает активные правила обезличивания.
//
// Параметры:
//   ВключаяСтрогие - Булево - включать правила, помеченные ТолькоСтрогийРежим
//           (они применяются только в режиме Токенизация).
//
// Возвращаемое значение:
//   Массив - элементы Структура("Образец, Замена, ТипДанных").
//
Функция АктивныеПравила(ВключаяСтрогие = Истина)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Правила.Образец КАК Образец,
	|	Правила.Замена КАК Замена,
	|	Правила.ТипДанных КАК ТипДанных
	|ИЗ
	|	Справочник.ИОО_ПравилаОбезличивания КАК Правила
	|ГДЕ
	|	Правила.Активно
	|	И НЕ Правила.ПометкаУдаления
	|	И (НЕ Правила.ТолькоСтрогийРежим ИЛИ &ВключаяСтрогие)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Правила.Порядок,
	|	Правила.Наименование";
	Запрос.УстановитьПараметр("ВключаяСтрогие", ВключаяСтрогие);
	Правила = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ПустаяСтрока(Выборка.Образец) Тогда
			Продолжить;
		КонецЕсли;
		Правило = Новый Структура("Образец, Замена, ТипДанных");
		Правило.Образец = Выборка.Образец;
		Правило.Замена = Выборка.Замена;
		Правило.ТипДанных = Выборка.ТипДанных;
		Правила.Добавить(Правило);
	КонецЦикла;
	Возврат Правила;

КонецФункции

Функция ЗаменитьЗначение(Результат, Значение, Замена)

	Образец = ЭкранироватьРегВыражение(СокрЛП(Строка(Значение)));
	Если ПустаяСтрока(Образец) Тогда
		Возврат 0;
	КонецЕсли;
	Было = Результат.Текст;
	Результат.Текст = СтрЗаменитьПоРегулярномуВыражению(Было, Образец, Замена, Истина);
	Возврат ?(Результат.Текст = Было, 0, 1);

КонецФункции

Функция ЗаменитьПоОбразцу(Результат, Образец, Замена)

	Если ПустаяСтрока(Образец) Тогда
		Возврат 0;
	КонецЕсли;
	Было = Результат.Текст;
	Попытка
		Результат.Текст = СтрЗаменитьПоРегулярномуВыражению(Было, Образец, Замена, Истина);
	Исключение
		// Ошибка в образце не должна останавливать обезличивание.
		Возврат 0;
	КонецПопытки;
	Возврат ?(Результат.Текст = Было, 0, 1);

КонецФункции

Процедура ДобавитьТип(Типы, ТипДанных)

	Если Типы.Найти(ТипДанных) = Неопределено Тогда
		Типы.Добавить(ТипДанных);
	КонецЕсли;

КонецПроцедуры
