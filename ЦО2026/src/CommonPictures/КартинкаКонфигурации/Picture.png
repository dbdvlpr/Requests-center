<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="42" height="42">
  <!-- Фон -->
  <rect x="1" y="1" width="46" height="46" rx="10" fill="#ad0101"/>

  <g transform="translate(0, 3)">
    <!-- Дуга наушников (над головой, с зазором) -->
    <path d="M10 19 Q10 5 24 5 Q38 5 38 19"
          fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round"/>

    <!-- Антенна -->
    <line x1="24" y1="17" x2="24" y2="11"
          stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/>
    <circle cx="24" cy="11" r="2" fill="#FFFFFF"/>

    <!-- Чашки наушников (отодвинуты от головы) -->
    <rect x="7"  y="17" width="6" height="13" rx="3" fill="#FFFFFF"/>
    <rect x="35" y="17" width="6" height="13" rx="3" fill="#FFFFFF"/>

    <!-- Голова -->
    <rect x="14" y="15" width="20" height="19" rx="5" fill="#FFFFFF"/>

    <!-- Визор -->
    <rect x="15.5" y="19" width="17" height="7" rx="3" fill="#ad0101"/>
    <circle cx="20" cy="22.5" r="1.5" fill="#FFFFFF"/>
    <circle cx="28" cy="22.5" r="1.5" fill="#FFFFFF"/>

    <!-- Решётка «рта» -->
    <rect x="20" y="29" width="2" height="1.5" rx="0.5" fill="#ad0101"/>
    <rect x="23" y="29" width="2" height="1.5" rx="0.5" fill="#ad0101"/>
    <rect x="26" y="29" width="2" height="1.5" rx="0.5" fill="#ad0101"/>

    <!-- Микрофон (из правой чашки вниз-влево) -->
    <path d="M38 30 Q38 36 32 36"
          fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/>
    <circle cx="31" cy="36" r="1.5" fill="#FFFFFF"/>
  </g>
</svg>
