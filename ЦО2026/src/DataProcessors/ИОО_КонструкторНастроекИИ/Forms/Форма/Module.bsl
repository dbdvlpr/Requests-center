#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НомерШага = 1;
	ПоказатьШаг();
	ЗагрузитьПрофиль(ИнтеграцияLLM.АктивныйПрофиль());

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НовыйПрофиль(Команда)

	ОчиститьФорму();

КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)

	ЗаписатьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Проверить(Команда)

	ПроверитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИзРеестра(Команда)

	ДополнитьИзРеестра();

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПараметр(Команда)

	ДобавитьСтрокуПараметра();

КонецПроцедуры

&НаКлиенте
Процедура Далее(Команда)

	ПерейтиНаШаг(НомерШага + 1);

КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)

	ПерейтиНаШаг(НомерШага - 1);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПерейтиНаШаг(Шаг)

	НомерШага = Макс(1, Мин(4, Шаг));
	ПоказатьШаг();

КонецПроцедуры

&НаСервере
Процедура ПоказатьШаг()

	Если НомерШага <= 1 Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаМодель;
	ИначеЕсли НомерШага = 2 Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПодключение;
	ИначеЕсли НомерШага = 3 Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаДополнительно;
	Иначе
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПроверка;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОчиститьФорму()

	Профиль = Справочники.ИОО_ПрофилиLLM.ПустаяСсылка();
	Наименование = "";
	Провайдер = Справочники.ИОО_ПровайдерыLLM.ПустаяСсылка();
	Модель = "";
	КлючAPI = "";
	РезультатПроверки = "";
	ЗаполнитьНастройки(Новый Соответствие);
	Параметры.Очистить();
	НомерШага = 1;
	ПоказатьШаг();

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПрофиль(Ссылка)

	Профиль = Ссылка;
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ОчиститьФорму();
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Профили.Наименование КАК Наименование,
	|	Профили.Провайдер КАК Провайдер,
	|	Профили.Модель КАК Модель,
	|	Профили.КлючAPI КАК КлючAPI
	|ИЗ
	|	Справочник.ИОО_ПрофилиLLM КАК Профили
	|ГДЕ
	|	Профили.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Профиль);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ОчиститьФорму();
		Возврат;
	КонецЕсли;
	Наименование = Выборка.Наименование;
	Провайдер = Выборка.Провайдер;
	Модель = Выборка.Модель;
	КлючAPI = Выборка.КлючAPI;
	РезультатПроверки = "";
	ЗаполнитьНастройки(СохраненныеНастройки(Профиль));
	ЗаполнитьПараметры(Профиль);

КонецПроцедуры

&НаСервере
Функция СохраненныеНастройки(Профиль)

	Результат = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Настройки.Поле КАК Поле,
	|	Настройки.Значение КАК Значение
	|ИЗ
	|	Справочник.ИОО_ПрофилиLLM.НастройкиИнтеграции КАК Настройки
	|ГДЕ
	|	Настройки.Ссылка = &Профиль";
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Поле, Выборка.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаполнитьПараметры(Профиль)

	Параметры.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Параметры.Имя КАК Имя,
	|	Параметры.Тип КАК Тип,
	|	Параметры.ЗначениеСтрокой КАК ЗначениеСтрокой
	|ИЗ
	|	Справочник.ИОО_ПрофилиLLM.Параметры КАК Параметры
	|ГДЕ
	|	Параметры.Ссылка = &Профиль";
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаПараметра = Параметры.Добавить();
		СтрокаПараметра.Имя = Выборка.Имя;
		СтрокаПараметра.Тип = Выборка.Тип;
		СтрокаПараметра.ЗначениеСтрокой = Выборка.ЗначениеСтрокой;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция РеестрПолей()

	Результат = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Поля.Ссылка КАК Поле,
	|	Поля.Ключ КАК Ключ,
	|	Поля.Назначение КАК Назначение,
	|	Поля.Обязательное КАК Обязательное,
	|	Поля.ПоУмолчанию КАК ПоУмолчанию,
	|	Поля.Подсказка КАК Подсказка
	|ИЗ
	|	Справочник.ИОО_ПоляНастроекИнтеграции КАК Поля
	|ГДЕ
	|	Поля.Активно
	|	И НЕ Поля.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Поля.Порядок,
	|	Поля.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("Поле", Выборка.Поле);
		Элемент.Вставить("Ключ", Выборка.Ключ);
		Элемент.Вставить("Назначение", Выборка.Назначение);
		Элемент.Вставить("Обязательное", Выборка.Обязательное);
		Элемент.Вставить("ПоУмолчанию", Выборка.ПоУмолчанию);
		Элемент.Вставить("Подсказка", Выборка.Подсказка);
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаполнитьНастройки(Сохраненные)

	НастройкиПодключения.Очистить();
	НастройкиДополнительные.Очистить();
	Для Каждого Описание Из РеестрПолей() Цикл
		Если Описание.Назначение = Перечисления.ИОО_НазначенияНастроекИнтеграции.Реквизит Тогда
			СтрокаНастройки = НастройкиПодключения.Добавить();
		Иначе
			СтрокаНастройки = НастройкиДополнительные.Добавить();
		КонецЕсли;
		СтрокаНастройки.Поле = Описание.Поле;
		СтрокаНастройки.Ключ = Описание.Ключ;
		СтрокаНастройки.Обязательное = Описание.Обязательное;
		СтрокаНастройки.Подсказка = Описание.Подсказка;
		Значение = Сохраненные.Получить(Описание.Поле);
		Если Значение = Неопределено Тогда
			СтрокаНастройки.Включено = Описание.ПоУмолчанию;
		Иначе
			СтрокаНастройки.Включено = Истина;
			СтрокаНастройки.Значение = Значение;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДополнитьИзРеестра()

	Существующие = Новый Соответствие;
	Для Каждого СтрокаНастройки Из НастройкиПодключения Цикл
		Существующие.Вставить(СтрокаНастройки.Поле, Истина);
	КонецЦикла;
	Для Каждого СтрокаНастройки Из НастройкиДополнительные Цикл
		Существующие.Вставить(СтрокаНастройки.Поле, Истина);
	КонецЦикла;
	Добавлено = 0;
	Для Каждого Описание Из РеестрПолей() Цикл
		Если Существующие.Получить(Описание.Поле) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Описание.Назначение = Перечисления.ИОО_НазначенияНастроекИнтеграции.Реквизит Тогда
			СтрокаНастройки = НастройкиПодключения.Добавить();
		Иначе
			СтрокаНастройки = НастройкиДополнительные.Добавить();
		КонецЕсли;
		СтрокаНастройки.Поле = Описание.Поле;
		СтрокаНастройки.Ключ = Описание.Ключ;
		СтрокаНастройки.Обязательное = Описание.Обязательное;
		СтрокаНастройки.Подсказка = Описание.Подсказка;
		СтрокаНастройки.Включено = Описание.ПоУмолчанию;
		Добавлено = Добавлено + 1;
	КонецЦикла;
	ПоказатьСообщение("Добавлено полей из реестра: " + Формат(Добавлено, "ЧГ=0") + ".");

КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуПараметра()

	СтрокаПараметра = Параметры.Добавить();
	СтрокаПараметра.Тип = Перечисления.ИОО_ТипыПараметров.Строка;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьНаСервере()

	Ошибки = Новый Массив;
	Если ПустаяСтрока(СокрЛП(Наименование)) Тогда
		Ошибки.Добавить("Укажите наименование профиля.");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Провайдер) Тогда
		Ошибки.Добавить("Выберите провайдера.");
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(Модель)) Тогда
		Ошибки.Добавить("Укажите модель.");
	КонецЕсли;
	ПроверитьОбязательные(НастройкиПодключения, Ошибки);
	ПроверитьОбязательные(НастройкиДополнительные, Ошибки);
	Если Ошибки.Количество() > 0 Тогда
		Для Каждого Текст Из Ошибки Цикл
			ПоказатьСообщение(Текст);
		КонецЦикла;
		НомерШага = 1;
		ПоказатьШаг();
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Профиль) Тогда
		Объект = Профиль.ПолучитьОбъект();
	Иначе
		Объект = Справочники.ИОО_ПрофилиLLM.СоздатьЭлемент();
	КонецЕсли;
	Объект.Наименование = СокрЛП(Наименование);
	Объект.Провайдер = Провайдер;
	Объект.Модель = СокрЛП(Модель);
	Объект.КлючAPI = СокрЛП(КлючAPI);
	Объект.НастройкиИнтеграции.Очистить();
	Порядок = ЗаписатьНастройки(Объект, НастройкиПодключения, 0);
	Порядок = ЗаписатьНастройки(Объект, НастройкиДополнительные, Порядок);
	Объект.Параметры.Очистить();
	Для Каждого СтрокаПараметра Из Параметры Цикл
		Если ПустаяСтрока(СокрЛП(СтрокаПараметра.Имя)) Тогда
			Продолжить;
		КонецЕсли;
		Новая = Объект.Параметры.Добавить();
		Новая.Имя = СокрЛП(СтрокаПараметра.Имя);
		Новая.Тип = СтрокаПараметра.Тип;
		Новая.ЗначениеСтрокой = СокрЛП(СтрокаПараметра.ЗначениеСтрокой);
	КонецЦикла;
	Объект.Записать();
	Профиль = Объект.Ссылка;
	ПоказатьСообщение("Профиль «" + Объект.Наименование + "» сохранён: настроек "
		+ Формат(Порядок, "ЧГ=0") + ", параметров " + Формат(Объект.Параметры.Количество(), "ЧГ=0") + ".");
	ПроверитьНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПроверитьОбязательные(ТаблицаНастроек, Ошибки)

	Для Каждого СтрокаНастройки Из ТаблицаНастроек Цикл
		Если СтрокаНастройки.Включено И СтрокаНастройки.Обязательное
			И ПустаяСтрока(СокрЛП(СтрокаНастройки.Значение)) Тогда
			Ошибки.Добавить("Заполните обязательную настройку «" + Строка(СтрокаНастройки.Поле) + "».");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ЗаписатьНастройки(Объект, ТаблицаНастроек, НачальныйПорядок)

	Порядок = НачальныйПорядок;
	Для Каждого СтрокаНастройки Из ТаблицаНастроек Цикл
		Если Не СтрокаНастройки.Включено Тогда
			Продолжить;
		КонецЕсли;
		Порядок = Порядок + 1;
		Новая = Объект.НастройкиИнтеграции.Добавить();
		Новая.Поле = СтрокаНастройки.Поле;
		Новая.Значение = СокрЛП(СтрокаНастройки.Значение);
		Новая.Порядок = Порядок;
	КонецЦикла;
	Возврат Порядок;

КонецФункции

&НаСервере
Процедура ПроверитьНаСервере()

	Строки = Новый Массив;
	Строки.Добавить("Проверка подключения профиля:");
	Строки.Добавить("- модель: " + ?(ПустаяСтрока(СокрЛП(Модель)), "не заполнена", Модель) + ";");
	Строки.Добавить("- провайдер: " + ?(ЗначениеЗаполнено(Провайдер), Строка(Провайдер), "не выбран") + ";");
	Включенных = 0;
	Для Каждого СтрокаНастройки Из НастройкиПодключения Цикл
		Если СтрокаНастройки.Включено Тогда
			Включенных = Включенных + 1;
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаНастройки Из НастройкиДополнительные Цикл
		Если СтрокаНастройки.Включено Тогда
			Включенных = Включенных + 1;
		КонецЕсли;
	КонецЦикла;
	Строки.Добавить("- включено настроек интеграции: " + Формат(Включенных, "ЧГ=0") + ";");
	Строки.Добавить("- параметров запроса: " + Формат(Параметры.Количество(), "ЧГ=0") + ".");

	Если ЗначениеЗаполнено(Профиль) И Не ПустаяСтрока(СокрЛП(КлючAPI)) Тогда
		Ответ = ИнтеграцияLLM.ПроверитьСоединение(Профиль);
		Строки.Добавить("");
		Если Ответ.Успех Тогда
			Строки.Добавить("Живой вызов модели выполнен успешно.");
		Иначе
			Строки.Добавить("Живой вызов не удался: " + Ответ.ТекстОшибки);
		КонецЕсли;
	Иначе
		Строки.Добавить("");
		Строки.Добавить("Живой вызов не выполнялся: сохраните профиль и укажите ключ API.");
	КонецЕсли;
	РезультатПроверки = СтрСоединить(Строки, Символы.ПС);
	НомерШага = 4;
	ПоказатьШаг();

КонецПроцедуры

&НаСервере
Процедура ПоказатьСообщение(Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти
