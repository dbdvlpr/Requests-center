&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Канал = Перечисления.КаналыОбращений.Почта;
	ОбновитьСписки();
	
КонецПроцедуры

&НаКлиенте
Процедура Принять(Команда)
	
	Сообщение = ПринятьНаСервере(Ложь);
	ОбновитьНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ПринятьВебФорму(Команда)
	
	Сообщение = ПринятьНаСервере(Истина);
	ОбновитьНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьПочту(Команда)
	
	Сообщение = ПолучитьПочтуНаСервере();
	ОбновитьНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	
	ОбновитьНаКлиенте();
	Сообщение = "Очередь обновлена.";
	
КонецПроцедуры

&НаКлиенте
Процедура ОчередьПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.Очередь.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПоказатьТекущее(ТекущиеДанные.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура Классифицировать(Команда)
	
	Если Не ЗначениеЗаполнено(ТекущееОбращение) Тогда
		Сообщение = "Выберите обращение в очереди.";
		Возврат;
	КонецЕсли;
	Сообщение = КлассифицироватьНаСервере();
	ОбновитьНаКлиенте();
	ПоказатьТекущее(ТекущееОбращение);
	
КонецПроцедуры

&НаКлиенте
Процедура Подтвердить(Команда)
	
	Сообщение = ПодтвердитьНаСервере();
	ОбновитьНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура Черновик(Команда)
	
	Сообщение = ЧерновикНаСервере();
	ПоказатьТекущее(ТекущееОбращение);
	
КонецПроцедуры

&НаКлиенте
Процедура Отправить(Команда)
	
	Сообщение = ОтправитьНаСервере();
	ОбновитьНаКлиенте();
	ПоказатьТекущее(ТекущееОбращение);
	
КонецПроцедуры

&НаКлиенте
Процедура Сообщено(Команда)
	
	Сообщение = СообщеноНаСервере();
	ОбновитьНаКлиенте();
	ПоказатьТекущее(ТекущееОбращение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокумент(Команда)
	
	Если ЗначениеЗаполнено(ТекущееОбращение) Тогда
		ПоказатьЗначение(, ТекущееОбращение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНаКлиенте()
	
	ОбновитьСписки();
	
КонецПроцедуры

&НаСервере
Функция ПринятьНаСервере(КакВебФорму)
	
	Данные = Новый Структура;
	Если КакВебФорму Тогда
		Данные.Вставить("Канал", Перечисления.КаналыОбращений.ВебФорма);
	Иначе
		Данные.Вставить("Канал", Канал);
	КонецЕсли;
	Данные.Вставить("Контрагент", Контрагент);
	Данные.Вставить("Тема", Тема);
	Данные.Вставить("Текст", Текст);
	Данные.Вставить("АдресОтвета", АдресОтвета);
	Данные.Вставить("ВнешнийИдентификатор", "");
	Результат = ОбработкаОбращений.ПринятьВходящее(Данные);
	Если Результат.Успех Тогда
		ТекущееОбращение = Результат.Ссылка;
		Текст = "";
		Тема = "";
	КонецЕсли;
	ОбновитьСписки();
	Возврат Результат.Текст;
	
КонецФункции

&НаСервере
Функция ПолучитьПочтуНаСервере()
	
	Результат = РаботаСПочтой.ПолучитьВходящие();
	ОбновитьСписки();
	Возврат Результат.Текст;
	
КонецФункции

&НаСервере
Процедура ОбновитьСписки()
	
	Очередь.Очистить();
	Для Каждого Элемент Из ОбработкаОбращений.СтрокиОчереди() Цикл
		ЗаполнитьЗначенияСвойств(Очередь.Добавить(), Элемент);
	КонецЦикла;
	Задачи.Очистить();
	Для Каждого Элемент Из ОбработкаОбращений.СтрокиЗадач() Цикл
		ЗаполнитьЗначенияСвойств(Задачи.Добавить(), Элемент);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьТекущее(Ссылка)
	
	ТекущееОбращение = Ссылка;
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	Объект = Ссылка.ПолучитьОбъект();
	ТекущееПредставление = "№ " + Объект.Номер + ", " + Строка(Объект.Канал) + ", " + Строка(Объект.Статус);
	Категория = Объект.Категория;
	Тональность = Объект.Тональность;
	Приоритет = Объект.Приоритет;
	Исполнитель = Объект.Исполнитель;
	ЧерновикОтвета = Объект.ЧерновикОтвета;
	Пояснение = Объект.ПояснениеПриоритета + Символы.ПС + Объект.ПояснениеНазначения;
	Если Не ПустаяСтрока(Объект.КомментарийОшибки) Тогда
		Пояснение = Пояснение + Символы.ПС + Объект.КомментарийОшибки;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция КлассифицироватьНаСервере()
	
	Результат = ОбработкаОбращений.Классифицировать(ТекущееОбращение);
	ОбновитьСписки();
	Возврат Результат.Текст;
	
КонецФункции

&НаСервере
Функция ПодтвердитьНаСервере()
	
	Результат = ОбработкаОбращений.Подтвердить(ТекущееОбращение, Категория, Тональность, Приоритет, Исполнитель, ЧерновикОтвета);
	ОбновитьСписки();
	Возврат Результат.Текст;
	
КонецФункции

&НаСервере
Функция ЧерновикНаСервере()
	
	Результат = ОбработкаОбращений.СформироватьЧерновик(ТекущееОбращение);
	Возврат Результат.Текст;
	
КонецФункции

&НаСервере
Функция ОтправитьНаСервере()
	
	Результат = ОбработкаОбращений.ОтправитьОтвет(ТекущееОбращение, ЧерновикОтвета, ТакжеНаПочту);
	ОбновитьСписки();
	Возврат Результат.Текст;
	
КонецФункции

&НаСервере
Функция СообщеноНаСервере()
	
	Если Не ЗначениеЗаполнено(ТекущееОбращение) Тогда
		Возврат "Не выбрано обращение.";
	КонецЕсли;
	Объект = ТекущееОбращение.ПолучитьОбъект();
	Если Объект.Канал <> Перечисления.КаналыОбращений.Звонок Тогда
		Возврат "Фиксация звонка доступна для обращений из канала «Звонок». Для почты и формы используйте «Отправить ответ».";
	КонецЕсли;
	Результат = ОбработкаОбращений.ОтправитьОтвет(ТекущееОбращение, ЧерновикОтвета, ТакжеНаПочту);
	ОбновитьСписки();
	Возврат Результат.Текст;
	
КонецФункции
