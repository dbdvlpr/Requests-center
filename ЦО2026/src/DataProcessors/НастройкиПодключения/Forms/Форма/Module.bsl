&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДемонстрационныеДанные.ОбеспечитьНастройкиПоУмолчанию();
	ПрочитатьНастройки();
	
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	
	СохранитьНаСервере();
	ПоказатьОповещениеПользователя("Настройки сохранены");
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСоединение(Команда)
	
	СохранитьНаСервере();
	РезультатПроверки = ТекстПроверкиНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначенияПоУмолчанию(Команда)
	
	Провайдер = ПредопределенноеЗначение("Справочник.ИОО_ПровайдерыLLM.YandexGPT");
	ИмяМодели = "yandexgpt/latest";
	СхемаАвторизации = "Api-Key";
	ТаймаутСекунд = 90;
	МаксимумТокенов = 2000;
	Температура = 0.1;
	КоличествоПримеров = 4;
	ОбластьДоступаGigaChat = "GIGACHAT_API_PERS";
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьНастройки()
	
	АктивныйПрофиль = Константы.АктивныйПрофильLLM.Получить();
	Если Не ЗначениеЗаполнено(АктивныйПрофиль) Тогда
		Возврат;
	КонецЕсли;
	
	Профиль = АктивныйПрофиль.ПолучитьОбъект();
	Провайдер = Профиль.Провайдер;
	КлючAPI = Профиль.КлючAPI;
	ИдентификаторКаталога = Профиль.ИдентификаторКаталога;
	ИмяМодели = Профиль.Модель;
	ТаймаутСекунд = Профиль.ТаймаутСекунд;
	МаксимумТокенов = Профиль.МаксимумТокенов;
	Температура = Профиль.Температура;
	КоличествоПримеров = Профиль.КоличествоПримеров;

	Если ЗначениеЗаполнено(Профиль.Провайдер) Тогда
		ПровайдерОбъект = Профиль.Провайдер.ПолучитьОбъект();
		АдресAPI = ПровайдерОбъект.АдресAPI;
		СхемаАвторизации = ПровайдерОбъект.СхемаАвторизации;
		ОбластьДоступаGigaChat = ПровайдерОбъект.ОбластьДоступа;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере()
	
	ПрофильСсылка = АктивныйПрофиль;
	Если Не ЗначениеЗаполнено(ПрофильСсылка) Тогда
		ПрофильСсылка = ИнтеграцияLLM.АктивныйПрофиль();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПрофильСсылка) Тогда
		Элемент = Справочники.ИОО_ПрофилиLLM.СоздатьЭлемент();
		Элемент.Наименование = "Профиль LLM";
		Элемент.Записать();
		ПрофильСсылка = Элемент.Ссылка;
	КонецЕсли;
	
	Профиль = ПрофильСсылка.ПолучитьОбъект();
	Профиль.Провайдер = Провайдер;
	Профиль.КлючAPI = КлючAPI;
	Профиль.ИдентификаторКаталога = ИдентификаторКаталога;
	Профиль.Модель = ИмяМодели;
	Профиль.ТаймаутСекунд = ТаймаутСекунд;
	Профиль.МаксимумТокенов = МаксимумТокенов;
	Профиль.Температура = Температура;
	Профиль.КоличествоПримеров = КоличествоПримеров;
	Профиль.Записать();
	
	Если ЗначениеЗаполнено(Провайдер) Тогда
		ПровайдерОбъект = Провайдер.ПолучитьОбъект();
		ПровайдерОбъект.АдресAPI = АдресAPI;
		ПровайдерОбъект.СхемаАвторизации = СхемаАвторизации;
		ПровайдерОбъект.ОбластьДоступа = ОбластьДоступаGigaChat;
		ПровайдерОбъект.Записать();
	КонецЕсли;
	
	Константы.АктивныйПрофильLLM.Установить(ПрофильСсылка);
	АктивныйПрофиль = ПрофильСсылка;
	
КонецПроцедуры

&НаСервере
Функция ТекстПроверкиНаСервере()
	
	Ответ = ИнтеграцияLLM.ПроверитьСоединение();
	Если Ответ.Успех Тогда
		Возврат "Соединение установлено. Модель ответила: " + Лев(Ответ.Текст, 500);
	КонецЕсли;
	Возврат Ответ.ТекстОшибки;
	
КонецФункции
