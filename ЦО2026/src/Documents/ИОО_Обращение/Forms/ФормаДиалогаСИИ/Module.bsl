#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекстОжидания = "ИИ формирует ответ…";
	Элементы.ОжиданиеПоле.Видимость = Ложь;
	ЛентаДиалога = "ИИ-помощник: здравствуйте! Отправьте описание обращения или задайте вопрос.";
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьОписание(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Сначала запишите обращение.");
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(Объект.Текст) Тогда
		ПоказатьПредупреждение(, "Описание обращения пустое — отправлять нечего.");
		Возврат;
	КонецЕсли;
	
	ДобавитьРеплику("Вы (описание обращения): " + Объект.Текст);
	ЗадатьВопросИИ(Объект.Текст);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСообщение(Команда)
	
	Если ПустаяСтрока(Вопрос) Тогда
		ПоказатьПредупреждение(, "Введите сообщение.");
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = Вопрос;
	Вопрос = "";
	ДобавитьРеплику("Вы: " + ТекстСообщения);
	ЗадатьВопросИИ(ТекстСообщения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьДиалог(Команда)
	
	ЛентаДиалога = "";
	Вопрос = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьДиалог(Команда)
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗадатьВопросИИ(ТекстСообщения)
	
	ПоказатьОжидание();
	Ответ = ОтветИИЗаглушка(ТекстСообщения);
	СкрытьОжидание();
	ДобавитьРеплику("ИИ: " + Ответ);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРеплику(Текст)
	
	Если Не ПустаяСтрока(ЛентаДиалога) Тогда
		ЛентаДиалога = ЛентаДиалога + Символы.ПС + Символы.ПС;
	КонецЕсли;
	ЛентаДиалога = ЛентаДиалога + Текст;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОжидание()
	
	Элементы.ОжиданиеПоле.Видимость = Истина;
	Элементы.ОтправитьОписание.Доступность = Ложь;
	Элементы.ОтправитьСообщение.Доступность = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СкрытьОжидание()
	
	Элементы.ОжиданиеПоле.Видимость = Ложь;
	Элементы.ОтправитьОписание.Доступность = Истина;
	Элементы.ОтправитьСообщение.Доступность = Истина;
	
КонецПроцедуры

&НаСервере
Функция ОтветИИЗаглушка(ТекстСообщения)
	
	// Заглушка вместо реального обращения к модели.
	// Здесь появится вызов ИнтеграцияLLM.
	Возврат "Заглушка: запрос принят (" + СтрДлина(ТекстСообщения) + " символов). "
		+ "Подключение к модели будет реализовано отдельно.";
	
КонецФункции

#КонецОбласти
