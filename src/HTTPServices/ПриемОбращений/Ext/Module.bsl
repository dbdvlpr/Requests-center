Функция Создать(Запрос) Экспорт
	
	Попытка
		Тело = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Объект = ИнтеграцияLLM.ПрочитатьОбъектJSON(Тело);
		Если ТипЗнч(Объект) <> Тип("Структура") Тогда
			Возврат ОтветJSON(400, Новый Структура("success, error", Ложь, "Ожидался JSON-объект."));
		КонецЕсли;
		Данные = Новый Структура;
		Данные.Вставить("Канал", Перечисления.КаналыОбращений.ВебФорма);
		Данные.Вставить("Тема", СтрокаПоля(Объект, "subject"));
		Данные.Вставить("Текст", СтрокаПоля(Объект, "text"));
		Данные.Вставить("АдресОтвета", СтрокаПоля(Объект, "email"));
		Данные.Вставить("ВнешнийИдентификатор", СтрокаПоля(Объект, "externalId"));
		Данные.Вставить("ИмяКонтрагента", СтрокаПоля(Объект, "name"));
		Данные.Вставить("Телефон", СтрокаПоля(Объект, "phone"));
		Данные.Вставить("ИНН", СтрокаПоля(Объект, "inn"));
		Данные.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
		Результат = ОбработкаОбращений.ПринятьВходящее(Данные);
		Код = ?(Результат.Успех, 200, 400);
		Возврат ОтветJSON(Код, Новый Структура("success, number, duplicate, message",
			Результат.Успех, Результат.Номер, Результат.Повтор, Результат.Текст));
	Исключение
		Возврат ОтветJSON(500, Новый Структура("success, error", Ложь, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	
КонецФункции

Функция Статус(Запрос) Экспорт
	
	Номер = "";
	Параметры = Запрос.ПараметрыЗапроса;
	Если Параметры <> Неопределено Тогда
		Значение = Параметры.Получить("number");
		Если Значение <> Неопределено Тогда
			Номер = Строка(Значение);
		КонецЕсли;
	КонецЕсли;
	Карточка = ОбработкаОбращений.СтатусДляПубликации(Номер);
	Код = ?(Карточка.Найдено, 200, 404);
	Возврат ОтветJSON(Код, Карточка.Данные);
	
КонецФункции

Функция СтрокаПоля(Объект, Имя)
	
	Если Объект.Свойство(Имя) И Объект[Имя] <> Неопределено Тогда
		Возврат СокрЛП(Строка(Объект[Имя]));
	КонецЕсли;
	Возврат "";
	
КонецФункции

Функция ОтветJSON(Код, Данные)
	
	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ИнтеграцияLLM.ВJSON(Данные), КодировкаТекста.UTF8);
	Возврат Ответ;
	
КонецФункции
