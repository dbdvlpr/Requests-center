&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДемонстрационныеДанные.ОбеспечитьНастройкиПоУмолчанию();
	ПрочитатьНастройки();
	
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	
	СохранитьНаСервере();
	ПоказатьОповещениеПользователя("Настройки сохранены");
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСоединение(Команда)
	
	СохранитьНаСервере();
	РезультатПроверки = ТекстПроверкиНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначенияПоУмолчанию(Команда)
	
	ВидПодключенияИИ = ПредопределенноеЗначение("Перечисление.ВидыПодключенияИИ.YandexGPT");
	ИмяМодели = "yandexgpt/latest";
	СхемаАвторизации = "Api-Key";
	ТаймаутСекунд = 90;
	МаксимумТокенов = 2000;
	Температура = 0.1;
	КоличествоПримеров = 4;
	ОбезличиватьПередОтправкой = Истина;
	ОбластьДоступаGigaChat = "GIGACHAT_API_PERS";
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьНастройки()
	
	Параметры = ИнтеграцияLLM.ПараметрыПодключения();
	ВидПодключенияИИ = Параметры.Вид;
	КлючAPI = Параметры.Ключ;
	ИдентификаторКаталога = Параметры.Каталог;
	ИмяМодели = Параметры.Модель;
	АдресAPI = Параметры.Адрес;
	СхемаАвторизации = Параметры.Схема;
	ТаймаутСекунд = Параметры.Таймаут;
	МаксимумТокенов = Параметры.МаксимумТокенов;
	Температура = Параметры.Температура;
	КоличествоПримеров = Константы.КоличествоПримеров.Получить();
	Если КоличествоПримеров <= 0 Тогда
		КоличествоПримеров = 4;
	КонецЕсли;
	ОбезличиватьПередОтправкой = Константы.ОбезличиватьПередОтправкой.Получить();
	ОбластьДоступаGigaChat = Параметры.ОбластьGigaChat;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере()
	
	Константы.ВидПодключенияИИ.Установить(ВидПодключенияИИ);
	Константы.КлючAPI.Установить(КлючAPI);
	Константы.ИдентификаторКаталога.Установить(ИдентификаторКаталога);
	Константы.ИмяМодели.Установить(ИмяМодели);
	Константы.АдресAPI.Установить(АдресAPI);
	Константы.СхемаАвторизации.Установить(СхемаАвторизации);
	Константы.ТаймаутСекунд.Установить(ТаймаутСекунд);
	Константы.МаксимумТокенов.Установить(МаксимумТокенов);
	Константы.Температура.Установить(Температура);
	Константы.КоличествоПримеров.Установить(КоличествоПримеров);
	Константы.ОбезличиватьПередОтправкой.Установить(ОбезличиватьПередОтправкой);
	Константы.ОбластьДоступаGigaChat.Установить(ОбластьДоступаGigaChat);
	
КонецПроцедуры

&НаСервере
Функция ТекстПроверкиНаСервере()
	
	Ответ = ИнтеграцияLLM.ПроверитьСоединение();
	Если Ответ.Успех Тогда
		Возврат "Соединение установлено. Модель ответила: " + Лев(Ответ.Текст, 500);
	КонецЕсли;
	Возврат Ответ.ТекстОшибки;
	
КонецФункции
